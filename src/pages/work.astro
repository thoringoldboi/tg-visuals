---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { filmProjects, social, photoProjects, photoGalleries, img } from '../data/work';
import { site } from '../config/site';
---

<BaseLayout
  title="Work"
  description="Selected work by TG Visuals — film & commercial, social content and photography."
>
  <section class="work-page">
    <div class="container">
      <p class="eyebrow" data-reveal>Work</p>
      <h1 class="work-page__title" data-reveal style="--reveal-delay:.05s">Selected work</h1>

      <!-- ==================== FILM & COMMERCIAL ==================== -->
      <section class="wgroup">
        <div class="wgroup__head">
          <h2 class="wgroup__title">Film &amp; Commercial</h2>
        </div>
        <div class="film-grid">
          {
            filmProjects.map((p) => {
              const Tag = p.videoUrl ? 'a' : 'div';
              return (
                <Tag
                  class="film"
                  data-reveal
                  {...(p.videoUrl ? { href: p.videoUrl, target: '_blank', rel: 'noopener' } : {})}
                >
                  <div class="film__media">
                    <Image src={img(p.cover)} alt={`${p.title} — ${p.category}`} widths={[600, 900, 1300]} sizes="(max-width:820px) 100vw, 50vw" class="wimg" loading="lazy" />
                    {p.videoUrl && <span class="film__play" aria-hidden="true">▶</span>}
                  </div>
                  <div class="film__cap">
                    <span class="film__title">{p.title}</span>
                    <span class="film__meta">{p.category}{p.year ? ` · ${p.year}` : ''}</span>
                  </div>
                </Tag>
              );
            })
          }
        </div>
      </section>

      <!-- ==================== SOCIAL ==================== -->
      <section class="wgroup">
        <div class="wgroup__head">
          <h2 class="wgroup__title">Social</h2>
          <span class="wgroup__note">{site.views} views across social platforms</span>
        </div>
        <div class="social-grid">
          {
            social.map((clip) => {
              const Tag = clip.url ? 'a' : 'figure';
              return (
                <Tag
                  class="clip"
                  data-reveal
                  {...(clip.url ? { href: clip.url, target: '_blank', rel: 'noopener' } : {})}
                >
                  <div class="clip__media">
                    <Image src={img(clip.cover)} alt={`${clip.platform} ${clip.format}`} widths={[240, 400]} sizes="(max-width:640px) 45vw, 220px" class="wimg" loading="lazy" />
                  </div>
                  <span class="clip__cap">{clip.platform} · {clip.format}</span>
                </Tag>
              );
            })
          }
        </div>
      </section>

      <!-- ==================== PHOTOGRAPHY ==================== -->
      <section class="wgroup">
        <div class="wgroup__head">
          <h2 class="wgroup__title">Photography</h2>
        </div>

        <p class="wgroup__sub">Featured projects</p>
        {
          photoProjects.map((proj) => (
            <div class="project" data-reveal>
              <div class="project__head">
                <h3 class="project__title">{proj.title}</h3>
                <span class="project__meta">{proj.category}{proj.year ? ` · ${proj.year}` : ''}</span>
              </div>
              <div class="photo-grid">
                {proj.images.map((name) => (
                  <div class="photo">
                    <Image src={img(name)} alt={proj.title} widths={[300, 600]} sizes="(max-width:640px) 50vw, 25vw" class="wimg" loading="lazy" />
                  </div>
                ))}
              </div>
            </div>
          ))
        }

        <p class="wgroup__sub wgroup__sub--spaced">Browse by category</p>
        {
          photoGalleries.map((g) => (
            <div class="project" data-reveal>
              <div class="project__head">
                <h3 class="project__title">{g.title}</h3>
              </div>
              <div class="photo-grid">
                {g.images.map((name) => (
                  <div class="photo">
                    <Image src={img(name)} alt={g.title} widths={[300, 600]} sizes="(max-width:640px) 50vw, 25vw" class="wimg" loading="lazy" />
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .work-page {
    padding-top: calc(var(--nav-h) + var(--space-xl));
    padding-bottom: var(--space-2xl);
  }
  .work-page__title {
    font-size: var(--step-4);
    letter-spacing: -0.035em;
    line-height: 1;
    margin: 0.3em 0 0;
  }

  /* Grayscale placeholder treatment — remove for real colour work. */
  .wimg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.03);
    transition: transform 1.1s var(--ease);
  }

  .wgroup { margin-top: var(--space-2xl); }
  .wgroup__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    flex-wrap: wrap;
    padding-bottom: var(--space-m);
    margin-bottom: var(--space-m);
    border-bottom: 1px solid var(--line);
  }
  .wgroup__title { font-size: var(--step-2); letter-spacing: -0.025em; }
  .wgroup__note {
    font-family: var(--font-display);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    color: var(--smoke);
  }
  .wgroup__sub {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--smoke-dim);
    margin-bottom: var(--space-s);
  }
  .wgroup__sub--spaced { margin-top: var(--space-xl); }

  /* Film & commercial */
  .film-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-m) var(--space-s);
  }
  .film { display: block; }
  .film__media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--charcoal);
  }
  .film:hover .wimg { transform: scale(1.04); }
  .film__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    font-size: 1.4rem;
    background: rgba(0, 0, 0, 0.25);
  }
  .film__cap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    margin-top: 0.8em;
    padding-bottom: 0.8em;
    border-bottom: 1px solid var(--line-soft);
  }
  .film__title { font-family: var(--font-display); font-weight: 600; }
  .film__meta { font-size: var(--step--1); color: var(--smoke-dim); white-space: nowrap; }
  @media (max-width: 640px) { .film-grid { grid-template-columns: 1fr; } }

  /* Social — vertical */
  .social-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-s);
  }
  .clip { display: block; }
  .clip__media {
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background: var(--charcoal);
  }
  .clip:hover .wimg { transform: scale(1.04); }
  .clip__cap {
    display: block;
    margin-top: 0.6em;
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--smoke-dim);
  }
  @media (max-width: 820px) { .social-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 520px) { .social-grid { grid-template-columns: repeat(2, 1fr); } }

  /* Photography */
  .project { margin-bottom: var(--space-l); }
  .project__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    margin-bottom: var(--space-s);
  }
  .project__title { font-size: var(--step-1); letter-spacing: -0.02em; font-weight: 600; }
  .project__meta { font-size: var(--step--1); color: var(--smoke-dim); white-space: nowrap; }
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-s);
  }
  .photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--charcoal);
  }
  .photo:hover .wimg { transform: scale(1.04); }
  @media (max-width: 640px) { .photo-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
