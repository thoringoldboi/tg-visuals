---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/work';
import { site } from '../config/site';
import portrait from '../assets/portrait/thor-portrait.jpg';

const approach = [
  {
    title: 'Production and performance',
    body: 'I care how the work looks and what it does. Every project is shot to be cinematic and built to earn attention online.',
  },
  {
    title: 'One set of hands, start to finish',
    body: 'Concept, shoot, edit and grade run through me — so nothing gets lost in a hand-off and the vision stays intact.',
  },
  {
    title: 'Built for where it lives',
    body: 'A brand film and a vertical hook need different instincts. I shoot and cut for the platform the work will actually run on.',
  },
];

const kit = ['Cinema & mirrorless bodies', 'Anamorphic & prime glass', 'Gimbal & stabilised rigs', 'Location & studio lighting', 'DaVinci Resolve grade'];
---

<BaseLayout
  title="About"
  description="Thorin Goldswain — the videographer and photographer behind TG Visuals, blending high-end production with a real understanding of social media."
>
  <section class="about">
    <div class="container about__grid">
      <div class="about__media" data-reveal>
        <Image
          src={portrait}
          alt="Thorin Goldswain, the videographer and photographer behind TG Visuals"
          widths={[420, 640, 900]}
          sizes="(max-width: 900px) 100vw, 44vw"
          class="about__img"
          loading="eager"
        />
      </div>
      <div class="about__intro">
        <p class="eyebrow" data-reveal>The person behind TG Visuals</p>
        <h1 class="about__title" data-reveal style="--reveal-delay:.05s">
          Thorin<br /><span class="serif-accent">Goldswain.</span>
        </h1>
        <div class="about__copy" data-reveal style="--reveal-delay:.1s">
          <p>
            I’m the eye, the camera and the edit behind <span class="text-red">TG&nbsp;Visuals</span>.
            I started it on one belief: great production should earn its keep — not
            just look good, but do something for the brand behind it.
          </p>
          <p class="muted">
            I work across video, photography and social-first content — and I’ve spent
            years learning what actually holds attention on a feed, not just what wins
            on a big screen. Content I’ve created has generated
            <span class="text-red">{site.views} views</span> across social platforms.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="approach">
        {
          approach.map((a, i) => (
            <div class="approach__item" data-reveal style={`--reveal-delay:${i * 0.06}s`}>
              <span class="approach__no">/ 0{i + 1}</span>
              <h2 class="approach__title">{a.title}</h2>
              <p class="approach__body muted">{a.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section--tight about__lists">
    <div class="container about__lists-grid">
      <div data-reveal>
        <h2 class="about__list-title">What I do</h2>
        <ul class="about__list">
          {services.map((s) => <li><span class="text-red">—</span> {s.title}</li>)}
        </ul>
      </div>
      <div data-reveal style="--reveal-delay:.06s">
        <h2 class="about__list-title">Kit &amp; craft</h2>
        <ul class="about__list">
          {kit.map((k) => <li><span class="text-red">—</span> {k}</li>)}
        </ul>
      </div>
      <div class="about__cta" data-reveal style="--reveal-delay:.12s">
        <p class="about__cta-text">Got something in mind?</p>
        <a href="/contact" class="btn btn--red">
          Start a project <span class="btn__arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Red chapter — the deliberate colour break */
  .about {
    position: relative;
    padding-top: calc(var(--nav-h) + var(--space-xl));
    padding-bottom: var(--space-2xl);
    background: var(--red);
    color: var(--white);
  }
  .about :global(.eyebrow) { color: rgba(255, 255, 255, 0.85); }
  .about :global(.eyebrow)::before { background: var(--ink); }
  .about :global(.serif-accent) { color: var(--ink); }
  .about :global(.text-red) { color: var(--ink); }
  .about .muted { color: rgba(255, 255, 255, 0.9); }
  .about__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--space-l);
    align-items: center;
  }
  .about__img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 25%;
    border-radius: var(--radius-media);
  }
  .about__title {
    font-size: var(--step-4);
    letter-spacing: -0.035em;
    line-height: 0.98;
    margin: 0.3em 0 0.6em;
  }
  .about__copy p {
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 46ch;
  }
  .about__copy p + p { margin-top: 1em; }

  .approach {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-m) var(--space-l);
    border-top: 1px solid var(--line-soft);
    padding-top: var(--space-l);
  }
  .approach__no {
    font-family: var(--font-display);
    font-size: 0.8rem;
    color: var(--red);
    letter-spacing: 0.08em;
  }
  .approach__title {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0.6em 0 0.5em;
  }
  .approach__body { font-size: var(--step-0); max-width: 34ch; }

  .about__lists-grid {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: var(--space-l);
    border-top: 1px solid var(--line-soft);
    padding-top: var(--space-l);
    align-items: start;
  }
  .about__list-title {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--smoke-dim);
    margin-bottom: 1.2em;
  }
  .about__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.7em;
    font-size: var(--step-1);
    font-family: var(--font-display);
    letter-spacing: -0.01em;
  }
  .about__list span { margin-right: 0.4em; }
  .about__cta-text {
    font-family: var(--font-display);
    font-size: var(--step-1);
    margin-bottom: 1em;
  }

  @media (max-width: 900px) {
    .about__grid { grid-template-columns: 1fr; }
    .about__img { max-height: 68vh; }
    .approach { grid-template-columns: 1fr; gap: var(--space-m); }
    .about__lists-grid { grid-template-columns: 1fr; gap: var(--space-m); }
  }
</style>
