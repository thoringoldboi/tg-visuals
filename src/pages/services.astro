---
import BaseLayout from '../layouts/BaseLayout.astro';
import Results from '../components/Results.astro';
import { services } from '../data/work';

const steps = [
  { name: 'Reach out', desc: 'Tell me about the brand, the goal and your timeline.' },
  { name: 'Plan', desc: 'We shape the concept, hooks, references and shot list so we’re aligned before the shoot.' },
  { name: 'Shoot', desc: 'I film it myself, directed and shot to match the idea.' },
  { name: 'Deliver', desc: 'Edited, graded and cut for every place it’s going: feed, ads, web.' },
];
---

<BaseLayout
  title="Services"
  description="Film and commercial video, short-form social content, organic social growth and Meta ads, and photography by Thorin Goldswain, Cape Town."
>
  <section class="services">
    <div class="container">
      <p class="eyebrow" data-reveal>Services</p>
      <h1 class="services__title" data-reveal style="--reveal-delay:.05s">What I do</h1>
      <p class="services__lede" data-reveal style="--reveal-delay:.1s">
        I make video and photography for brands, and I understand what happens to it after
        it’s posted. From a cinematic brand film to a run of reels and the Meta campaigns
        behind them, I can handle the idea, the shoot, the edit and the growth.
      </p>

      <ol class="svc-list">
        {services.map((s, i) => (
          <li class="svc" data-reveal style={`--reveal-delay:${0.12 + i * 0.05}s`}>
            <span class="svc__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="svc__body">
              <h2 class="svc__title">{s.title}</h2>
              <p class="svc__desc">{s.desc}</p>
            </div>
            <ul class="svc__inc">
              {s.includes.map((x) => <li>{x}</li>)}
            </ul>
          </li>
        ))}
      </ol>

      <div class="proof">
        <div class="proof__head" data-reveal>
          <h2 class="proof__title">Results</h2>
          <p class="proof__note">
            As manager at SHOOT. Studios, a photo and video studio in Woodstock, I ran all
            of the studio’s content and its Meta ad campaigns. The growth came from a run of
            content and campaigns, not one lucky post.
          </p>
        </div>
        <Results />
      </div>

      <div class="process">
        <h2 class="process__head" data-reveal>How it works</h2>
        <ol class="steps">
          {steps.map((st, i) => (
            <li class="step" data-reveal style={`--reveal-delay:${0.06 + i * 0.05}s`}>
              <span class="step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="step__name">{st.name}</span>
              <span class="step__desc">{st.desc}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container cta__inner">
      <h2 class="cta__title">Let’s create something.</h2>
      <a href="/contact" class="btn cta__btn">
        Start a project <span class="btn__arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .services {
    padding-top: calc(var(--nav-h) + var(--space-xl));
    padding-bottom: var(--space-xl);
  }
  .services__title {
    font-size: var(--step-4);
    letter-spacing: -0.035em;
    line-height: 1;
    margin: 0.25em 0 var(--space-m);
  }
  .services__lede {
    color: var(--smoke);
    max-width: 58ch;
    line-height: 1.6;
    margin-bottom: var(--space-2xl);
  }

  /* Services list: editorial index style */
  .svc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .svc {
    display: grid;
    grid-template-columns: auto 1.4fr 1fr;
    gap: var(--space-m);
    align-items: start;
    padding: var(--space-l) 0;
    border-bottom: 1px solid var(--line);
  }
  .svc__num {
    font-family: var(--font-display);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    color: var(--smoke-dim);
    padding-top: 0.5em;
  }
  .svc__title {
    font-size: var(--step-2);
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin-bottom: 0.45em;
  }
  .svc__desc {
    color: var(--smoke);
    line-height: 1.6;
    max-width: 58ch;
  }
  .svc__inc {
    list-style: none;
    margin: 0;
    padding: 0.5em 0 0;
    display: grid;
    gap: 0.55em;
    font-family: var(--font-display);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
  }
  .svc__inc li { padding-left: 1.2em; position: relative; }
  .svc__inc li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.55em;
    height: 1px;
    background: var(--ink);
  }

  /* Results */
  .proof { margin-top: var(--space-2xl); }
  .proof__head {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--space-m);
    align-items: baseline;
    margin-bottom: var(--space-l);
  }
  .proof__title { font-size: var(--step-2); letter-spacing: -0.025em; }
  .proof__note { color: var(--smoke); line-height: 1.6; max-width: 58ch; }

  /* Process */
  .process { margin-top: var(--space-2xl); }
  .process__head {
    font-size: var(--step-2);
    letter-spacing: -0.025em;
    margin-bottom: var(--space-l);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-m);
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
  }
  .step__num {
    font-family: var(--font-display);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    color: var(--smoke-dim);
  }
  .step__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }
  .step__desc { color: var(--smoke); line-height: 1.55; font-size: var(--step--1); }

  @media (max-width: 900px) {
    .svc { grid-template-columns: auto 1fr; }
    .svc__inc { grid-column: 2; padding-top: 0; }
  }
  @media (max-width: 760px) {
    .svc { grid-template-columns: 1fr; gap: 0.6em; }
    .svc__num { padding-top: 0; }
    .svc__inc { grid-column: auto; margin-top: 0.4em; }
    .proof__head { grid-template-columns: 1fr; gap: 0.6em; }
    .steps { grid-template-columns: 1fr 1fr; gap: var(--space-m) var(--space-s); }
  }
  @media (max-width: 460px) {
    .steps { grid-template-columns: 1fr; }
  }

  /* CTA (mirrors the home page) */
  .cta {
    padding-block: var(--space-l) var(--space-l);
    text-align: center;
  }
  .cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-s);
  }
  .cta__title {
    font-size: var(--step-3);
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0;
  }
  .cta__btn { margin-top: var(--space-xs); }
</style>
