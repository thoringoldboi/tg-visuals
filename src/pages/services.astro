---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/work';

const steps = [
  { name: 'Reach out', desc: 'Tell me about the project. The idea, the goal and your timeline.' },
  { name: 'Plan', desc: 'We shape the concept, references and shot list so we’re aligned before the shoot.' },
  { name: 'Shoot', desc: 'I capture it. Directed, shot and lit to match the vision.' },
  { name: 'Deliver', desc: 'Edited, graded and delivered, ready for wherever it’s going.' },
];
---

<BaseLayout title="Services" description="What TG Visuals offers: commercial and brand film, social content, social media management and photography.">
  <section class="services">
    <div class="container">
      <p class="eyebrow" data-reveal>Services</p>
      <h1 class="services__title" data-reveal style="--reveal-delay:.05s">What I do</h1>
      <p class="services__lede" data-reveal style="--reveal-delay:.1s">
        I create video and photography for brands. From short-form social content
        built to perform, to cinematic commercial work. Here’s how I can help, and
        how we’d work together.
      </p>

      <ol class="svc-list">
        {services.map((s, i) => (
          <li class="svc" data-reveal style={`--reveal-delay:${0.12 + i * 0.05}s`}>
            <span class="svc__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="svc__body">
              <h2 class="svc__title">{s.title}</h2>
              <p class="svc__desc">{s.desc}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="process">
        <h2 class="process__head" data-reveal>How it works</h2>
        <ol class="steps">
          {steps.map((st, i) => (
            <li class="step" data-reveal style={`--reveal-delay:${0.06 + i * 0.05}s`}>
              <span class="step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="step__name">{st.name}</span>
              <span class="step__desc">{st.desc}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container cta__inner">
      <h2 class="cta__title">Let’s create something.</h2>
      <a href="/contact" class="btn cta__btn">
        Start a project <span class="btn__arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .services {
    padding-top: calc(var(--nav-h) + var(--space-xl));
    padding-bottom: var(--space-xl);
  }
  .services__title {
    font-size: var(--step-4);
    letter-spacing: -0.035em;
    line-height: 1;
    margin: 0.25em 0 var(--space-m);
  }
  .services__lede {
    color: var(--smoke);
    max-width: 56ch;
    line-height: 1.6;
    margin-bottom: var(--space-2xl);
  }

  /* Services list — editorial index style */
  .svc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .svc {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-m);
    align-items: start;
    padding: var(--space-l) 0;
    border-bottom: 1px solid var(--line);
  }
  .svc__num {
    font-family: var(--font-display);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    color: var(--smoke-dim);
    padding-top: 0.5em;
  }
  .svc__title {
    font-size: var(--step-2);
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin-bottom: 0.45em;
  }
  .svc__desc {
    color: var(--smoke);
    line-height: 1.6;
    max-width: 58ch;
  }

  /* Process */
  .process { margin-top: var(--space-2xl); }
  .process__head {
    font-size: var(--step-2);
    letter-spacing: -0.025em;
    margin-bottom: var(--space-l);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-m);
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
  }
  .step__num {
    font-family: var(--font-display);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    color: var(--smoke-dim);
  }
  .step__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }
  .step__desc { color: var(--smoke); line-height: 1.55; font-size: var(--step--1); }

  @media (max-width: 760px) {
    .svc { grid-template-columns: 1fr; gap: 0.4em; }
    .svc__num { padding-top: 0; }
    .steps { grid-template-columns: 1fr 1fr; gap: var(--space-m) var(--space-s); }
  }
  @media (max-width: 460px) {
    .steps { grid-template-columns: 1fr; }
  }

  /* CTA (mirrors the home page) */
  .cta {
    padding-block: var(--space-l) var(--space-l);
    text-align: center;
  }
  .cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-s);
  }
  .cta__title {
    font-size: var(--step-3);
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0;
  }
  .cta__btn { margin-top: var(--space-xs); }
</style>
