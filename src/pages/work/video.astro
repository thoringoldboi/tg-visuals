---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { filmProjects, social, img } from '../../data/work';
import { site } from '../../config/site';
---

<BaseLayout title="Video — Work" description="Film, commercial and social video by TG Visuals.">
  <section class="work-sub">
    <div class="container">
      <nav class="crumbs" data-reveal>
        <a href="/work">Work</a> <span aria-hidden="true">/</span> <span class="crumbs__here">Video</span>
      </nav>
      <h1 class="work-sub__title" data-reveal style="--reveal-delay:.05s">Video</h1>

      <!-- Film & Commercial -->
      <section class="wgroup">
        <div class="wgroup__head"><h2 class="wgroup__title">Film &amp; Commercial</h2></div>
        <div class="film-grid">
          {
            filmProjects.map((p) => {
              const Tag = p.videoUrl ? 'a' : 'div';
              return (
                <Tag class="film" data-reveal {...(p.videoUrl ? { href: p.videoUrl, target: '_blank', rel: 'noopener' } : {})}>
                  <div class="film__media">
                    <Image src={img(p.cover)} alt={`${p.title} — ${p.category}`} widths={[600, 900, 1300]} sizes="(max-width:820px) 100vw, 50vw" class="wimg" loading="lazy" />
                    {p.videoUrl && <span class="film__play" aria-hidden="true">▶</span>}
                  </div>
                  <div class="film__cap">
                    <span class="film__title">{p.title}</span>
                    <span class="film__meta">{p.category}{p.year ? ` · ${p.year}` : ''}</span>
                  </div>
                </Tag>
              );
            })
          }
        </div>
      </section>

      <!-- Social -->
      <section class="wgroup">
        <div class="wgroup__head">
          <h2 class="wgroup__title">Social</h2>
          <span class="wgroup__note">{site.views} views across social platforms</span>
        </div>
        <div class="social-grid">
          {
            social.map((clip) => {
              const Tag = clip.url ? 'a' : 'figure';
              return (
                <Tag class="clip" data-reveal {...(clip.url ? { href: clip.url, target: '_blank', rel: 'noopener' } : {})}>
                  <div class="clip__media">
                    <Image src={img(clip.cover)} alt={`${clip.platform} ${clip.format}`} widths={[240, 400]} sizes="(max-width:640px) 45vw, 220px" class="wimg" loading="lazy" />
                  </div>
                  <span class="clip__cap">{clip.platform} · {clip.format}</span>
                </Tag>
              );
            })
          }
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .work-sub { padding-top: calc(var(--nav-h) + var(--space-l)); padding-bottom: var(--space-2xl); }
  .crumbs {
    font-family: var(--font-display);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    color: var(--smoke-dim);
    display: flex;
    gap: 0.5em;
  }
  .crumbs a { color: var(--smoke); }
  .crumbs a:hover { color: var(--ink); }
  .crumbs__here { color: var(--ink); }
  .work-sub__title {
    font-size: var(--step-4);
    letter-spacing: -0.035em;
    line-height: 1;
    margin: 0.25em 0 0;
  }

  .wimg { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.03); transition: transform 1.1s var(--ease); }

  .wgroup { margin-top: var(--space-2xl); }
  .wgroup__head {
    display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-s);
    flex-wrap: wrap; padding-bottom: var(--space-m); margin-bottom: var(--space-m);
    border-bottom: 1px solid var(--line);
  }
  .wgroup__title { font-size: var(--step-2); letter-spacing: -0.025em; }
  .wgroup__note { font-family: var(--font-display); font-size: var(--step--1); color: var(--smoke); }

  .film-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-m) var(--space-s); }
  .film { display: block; }
  .film__media { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--charcoal); }
  .film:hover .wimg { transform: scale(1.04); }
  .film__play { position: absolute; inset: 0; display: grid; place-items: center; color: #fff; font-size: 1.4rem; background: rgba(0,0,0,0.25); }
  .film__cap { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-s); margin-top: 0.8em; padding-bottom: 0.8em; border-bottom: 1px solid var(--line-soft); }
  .film__title { font-family: var(--font-display); font-weight: 600; }
  .film__meta { font-size: var(--step--1); color: var(--smoke-dim); white-space: nowrap; }
  @media (max-width: 640px) { .film-grid { grid-template-columns: 1fr; } }

  .social-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-s); }
  .clip { display: block; }
  .clip__media { aspect-ratio: 9 / 16; overflow: hidden; background: var(--charcoal); }
  .clip:hover .wimg { transform: scale(1.04); }
  .clip__cap { display: block; margin-top: 0.6em; font-family: var(--font-display); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--smoke-dim); }
  @media (max-width: 820px) { .social-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 520px) { .social-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
