---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { films, socialVideos, resolveVideos } from '../../data/work';
import { site } from '../../config/site';

const filmVids = await resolveVideos(films);
const socialVids = await resolveVideos(socialVideos);
const hasVideos = filmVids.length + socialVids.length > 0;
---

<BaseLayout title="Video — Work" description="Film, commercial and social video by TG Visuals.">
  <section class="work-sub">
    <div class="container">
      <nav class="crumbs" data-reveal>
        <a href="/work">Work</a> <span aria-hidden="true">/</span> <span class="crumbs__here">Video</span>
      </nav>
      <h1 class="work-sub__title" data-reveal style="--reveal-delay:.05s">Video</h1>

      {!hasVideos && (
        <p class="empty" data-reveal style="--reveal-delay:.1s">
          Films coming soon.
        </p>
      )}

      {filmVids.length > 0 && (
        <section class="wgroup">
          <div class="wgroup__head"><h2 class="wgroup__title">Film &amp; Commercial</h2></div>
          <div class="film-grid">
            {filmVids.map((v) => (
              <button class:list={['film', { 'film--v': v.vertical }]} type="button" data-video={v.id} data-vertical={v.vertical ? 'true' : 'false'} data-reveal aria-label={`Play ${v.title}`}>
                <div class="film__media">
                  {v.thumb ? <img src={v.thumb} alt={v.title} class="vimg" loading="lazy" onerror="this.onerror=null;this.src=this.src.replace('maxresdefault','hqdefault')" /> : <span class="film__ph" aria-hidden="true" />}
                  <span class="film__play" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
                  </span>
                </div>
                <div class="film__cap">
                  <span class="film__title">{v.title}</span>
                  {v.category && <span class="film__meta">{v.category}</span>}
                </div>
              </button>
            ))}
          </div>
        </section>
      )}

      {socialVids.length > 0 && (
        <section class="wgroup">
          <div class="wgroup__head">
            <h2 class="wgroup__title">Social content</h2>
            <span class="wgroup__note">{site.views} views across social platforms</span>
          </div>
          <div class="social-grid">
            {socialVids.map((v) => (
              <button class="clip" type="button" data-video={v.id} data-vertical="true" data-reveal aria-label={`Play ${v.title}`}>
                <div class="clip__media">
                  {v.thumb ? <img src={v.thumb} alt={v.title} class="vimg" loading="lazy" onerror="this.onerror=null;this.src=this.src.replace('maxresdefault','hqdefault')" /> : <span class="film__ph" aria-hidden="true" />}
                  <span class="film__play" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
                  </span>
                </div>
                {v.title && <span class="clip__cap">{v.title}</span>}
              </button>
            ))}
          </div>
        </section>
      )}
    </div>
  </section>

  <!-- Lightbox player -->
  <div class="vbox" id="vbox" hidden>
    <button class="vbox__close" id="vboxClose" type="button" aria-label="Close">✕</button>
    <div class="vbox__frame" id="vboxFrame"></div>
  </div>
</BaseLayout>

<style>
  .work-sub { padding-top: calc(var(--nav-h) + var(--space-l)); padding-bottom: var(--space-2xl); }
  .crumbs {
    font-family: var(--font-display);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    color: var(--smoke-dim);
    display: flex;
    gap: 0.5em;
  }
  .crumbs a { color: var(--smoke); }
  .crumbs a:hover { color: var(--ink); }
  .crumbs__here { color: var(--ink); }
  .work-sub__title {
    font-size: var(--step-4);
    letter-spacing: -0.035em;
    line-height: 1;
    margin: 0.25em 0 0;
  }
  .empty {
    margin-top: var(--space-l);
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--smoke-dim);
  }

  .vimg { width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s var(--ease); }
  .film__ph { position: absolute; inset: 0; background: var(--charcoal); }

  .wgroup { margin-top: var(--space-2xl); }
  .wgroup__head {
    display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-s);
    flex-wrap: wrap; padding-bottom: var(--space-m); margin-bottom: var(--space-m);
    border-bottom: 1px solid var(--line);
  }
  .wgroup__title { font-size: var(--step-2); letter-spacing: -0.025em; }
  .wgroup__note { font-family: var(--font-display); font-size: var(--step--1); color: var(--smoke); }

  /* Reset button chrome so the tiles look like plain cards */
  .film, .clip {
    appearance: none;
    border: 0;
    padding: 0;
    background: none;
    text-align: left;
    color: inherit;
    font: inherit;
    cursor: pointer;
    display: block;
    width: 100%;
  }

  .film-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-m) var(--space-s); align-items: start; }
  .film__media { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--charcoal); }
  /* A vertical film sits in the landscape grid as a properly-sized 9:16 card. */
  .film--v .film__media { aspect-ratio: 9 / 16; max-width: 300px; }
  .film:hover .vimg { transform: scale(1.04); }
  .film__play {
    position: absolute; inset: 0; display: grid; place-items: center;
    color: #fff; background: rgba(0,0,0,0.28);
    opacity: 0; transition: opacity var(--dur) var(--ease);
  }
  .film__play svg { transform: translateX(1px); }
  .film:hover .film__play, .clip:hover .film__play, .film:focus-visible .film__play, .clip:focus-visible .film__play { opacity: 1; }
  .film__cap { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-s); margin-top: 0.8em; padding-bottom: 0.8em; border-bottom: 1px solid var(--line-soft); }
  .film__title { font-family: var(--font-display); font-weight: 600; }
  .film__meta { font-size: var(--step--1); color: var(--smoke-dim); white-space: nowrap; }
  @media (max-width: 640px) { .film-grid { grid-template-columns: 1fr; } }

  .social-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-s); }
  .clip__media { position: relative; aspect-ratio: 9 / 16; overflow: hidden; background: var(--charcoal); }
  .clip:hover .vimg { transform: scale(1.04); }
  .clip__cap { display: block; margin-top: 0.6em; min-height: 2.1em; line-height: 1.35; font-family: var(--font-display); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--smoke-dim); }
  @media (max-width: 820px) { .social-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 520px) { .social-grid { grid-template-columns: repeat(2, 1fr); } }

  /* ---------------- Lightbox ---------------- */
  .vbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    padding: var(--gutter);
    background: rgba(0, 0, 0, 0.92);
  }
  .vbox[hidden] { display: none; }
  .vbox__frame {
    position: relative;
    width: min(100%, 1200px);
    aspect-ratio: 16 / 9;
  }
  .vbox__frame.is-vertical { aspect-ratio: 9 / 16; width: auto; height: min(84vh, 900px); }
  .vbox__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .vbox__close {
    position: absolute;
    top: max(var(--gutter), 1rem);
    right: max(var(--gutter), 1rem);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: none;
    border: 0;
    color: #fff;
    font-size: 1.3rem;
    cursor: pointer;
    opacity: 0.85;
  }
  .vbox__close:hover { opacity: 1; }
</style>

<script>
  const box = document.getElementById('vbox') as HTMLElement | null;
  const frame = document.getElementById('vboxFrame') as HTMLElement | null;
  const closeBtn = document.getElementById('vboxClose');

  function open(id: string, vertical: boolean) {
    if (!box || !frame) return;
    const params = 'autoplay=1&rel=0&modestbranding=1&playsinline=1';
    frame.classList.toggle('is-vertical', vertical);
    frame.innerHTML =
      `<iframe src="https://www.youtube.com/embed/${id}?${params}" ` +
      `allow="autoplay; fullscreen; picture-in-picture; encrypted-media" allowfullscreen></iframe>`;
    box.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function close() {
    if (!box || !frame) return;
    box.hidden = true;
    frame.innerHTML = '';
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLElement>('[data-video]').forEach((el) => {
    el.addEventListener('click', () => {
      const id = el.dataset.video || '';
      const vertical = el.dataset.vertical === 'true';
      if (id) open(id, vertical);
    });
  });

  closeBtn?.addEventListener('click', close);
  box?.addEventListener('click', (e) => {
    if (e.target === box) close();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && box && !box.hidden) close();
  });
</script>
