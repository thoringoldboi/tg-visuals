---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { img, films, photography, social } from '../../data/work';

const disciplines = [
  {
    label: 'Film & Video',
    href: '/work/film',
    meta: 'Cinematic films · Commercial · Music video · Promo',
    count: films.length,
    cover: 'film-01',
  },
  {
    label: 'Photography',
    href: '/work/photography',
    meta: 'Product · Studio · Commercial · Lifestyle · Creative',
    count: photography.length,
    cover: 'photo-studio-01',
  },
  {
    label: 'Social Content',
    href: '/work/social',
    meta: 'Instagram Reels · TikTok · Short-form commercial',
    count: social.length,
    cover: 'social-02',
  },
];
---

<BaseLayout title="Work" description="Selected film, photography and social work by TG Visuals.">
  <PageHeader
    eyebrow="Portfolio"
    title="Work across three disciplines"
    intro="Cinematic film, editorial photography and short-form social content — pick a lane, or explore the full body of work."
  />

  <section class="section--tight">
    <div class="container">
      <div class="disc-rows">
        {
          disciplines.map((d, i) => (
            <a href={d.href} class="disc-row" data-reveal>
              <span class="disc-row__index">0{i + 1}</span>
              <div class="disc-row__media">
                <Image
                  src={img(d.cover)}
                  alt=""
                  widths={[400, 700, 1100]}
                  sizes="(max-width: 760px) 100vw, 40vw"
                  class="disc-row__img"
                />
              </div>
              <div class="disc-row__text">
                <h2 class="disc-row__label">{d.label}</h2>
                <p class="disc-row__meta">{d.meta}</p>
              </div>
              <span class="disc-row__count">
                {String(d.count).padStart(2, '0')}
                <span class="disc-row__count-label">projects</span>
              </span>
              <span class="disc-row__arrow" aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .disc-rows {
    display: grid;
    border-top: 1px solid var(--line-soft);
  }
  .disc-row {
    display: grid;
    grid-template-columns: auto 22% 1fr auto auto;
    align-items: center;
    gap: var(--space-m);
    padding-block: clamp(1.4rem, 3vw, 2.6rem);
    border-bottom: 1px solid var(--line-soft);
    transition: padding-inline var(--dur) var(--ease);
  }
  .disc-row:hover {
    padding-inline: 1.2rem;
  }
  .disc-row__index {
    font-family: var(--font-display);
    font-size: 0.8rem;
    color: var(--red);
    letter-spacing: 0.08em;
  }
  .disc-row__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: var(--charcoal);
  }
  .disc-row__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.8) saturate(1.05);
    transition: transform 1s var(--ease), filter 0.7s var(--ease);
  }
  .disc-row:hover .disc-row__img {
    transform: scale(1.06);
    filter: brightness(1) saturate(1.1);
  }
  .disc-row__label {
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .disc-row__meta {
    color: var(--smoke-dim);
    font-size: var(--step--1);
    margin-top: 0.5em;
  }
  .disc-row__count {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--ink);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1;
  }
  .disc-row__count-label {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--smoke-dim);
    margin-top: 0.5em;
  }
  .disc-row__arrow {
    font-size: 1.4rem;
    color: var(--smoke-dim);
    transition: transform var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .disc-row:hover .disc-row__arrow {
    transform: translate(4px, -4px);
    color: var(--red);
  }

  @media (max-width: 760px) {
    .disc-row {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'index arrow'
        'media media'
        'text  count';
      gap: var(--space-s);
    }
    .disc-row__index { grid-area: index; }
    .disc-row__arrow { grid-area: arrow; justify-self: end; }
    .disc-row__media { grid-area: media; aspect-ratio: 16 / 9; }
    .disc-row__text { grid-area: text; }
    .disc-row__count { grid-area: count; align-self: end; }
    .disc-row:hover { padding-inline: 0; }
  }
</style>
