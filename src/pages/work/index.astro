---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { films, socialVideos } from '../../data/work';

// Video unlocks automatically once you paste a Vimeo link into work.ts.
const videoReady = films.length + socialVideos.length > 0;

const folders = [
  { href: '/work/video', title: 'Video', meta: 'Film · Commercial · Social', soon: !videoReady },
  { href: '/work/photography', title: 'Photography', meta: 'Studio · Portraits · Automotive' },
];
---

<BaseLayout title="Work" description="Selected work by TG Visuals — video and photography.">
  <section class="work-landing">
    <div class="container">
      <p class="eyebrow" data-reveal>Work</p>
      <h1 class="work-landing__title" data-reveal style="--reveal-delay:.05s">Selected work</h1>

      <div class="folders">
        {
          folders.map((f, i) => {
            const Tag = f.soon ? 'div' : 'a';
            return (
              <Tag
                {...(f.soon ? { 'aria-disabled': 'true' } : { href: f.href })}
                class:list={['folder', { 'folder--soon': f.soon }]}
                data-reveal
                style={`--reveal-delay:${0.08 + i * 0.06}s`}
              >
                {f.soon ? (
                  <span class="folder__badge">
                    <span class="folder__badge-icon" aria-hidden="true">🚧</span>
                    Coming soon
                  </span>
                ) : (
                  <span class="folder__arrow" aria-hidden="true">↗</span>
                )}
                <span class="folder__title">{f.title}</span>
                <span class="folder__meta">{f.meta}</span>
              </Tag>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .work-landing {
    padding-top: calc(var(--nav-h) + var(--space-l));
    padding-bottom: var(--space-xl);
  }
  .work-landing__title {
    font-size: var(--step-2);
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0.3em 0 var(--space-l);
  }
  .folders {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-m);
  }
  .folder {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    aspect-ratio: 16 / 10;
    padding: var(--space-m);
    border: 1px solid var(--line);
    background: var(--paper);
    overflow: hidden;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .folder:hover { background: var(--ink); color: var(--paper); }

  /* Coming-soon folder: not a link, muted, no hover invert */
  .folder--soon {
    cursor: not-allowed;
    border-style: dashed;
    color: var(--smoke-dim);
  }
  .folder--soon .folder__title { color: var(--smoke); }
  .folder--soon:hover { background: var(--paper); color: var(--smoke-dim); }
  .folder__badge {
    position: absolute;
    top: var(--space-m);
    right: var(--space-m);
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.4em 0.7em;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--smoke);
    background: var(--paper-2);
    white-space: nowrap;
  }
  .folder__badge-icon { font-size: 1.05em; }
  .folder__title {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }
  .folder__arrow {
    position: absolute;
    top: var(--space-m);
    right: var(--space-m);
    color: var(--smoke-dim);
    transition: transform var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .folder:hover .folder__arrow { transform: translate(4px, -4px); color: var(--paper); }
  .folder__meta {
    display: block;
    margin-top: 0.5em;
    font-size: var(--step--1);
    color: var(--smoke-dim);
    transition: color var(--dur) var(--ease);
  }
  .folder:hover .folder__meta { color: rgba(255, 255, 255, 0.7); }
  @media (max-width: 760px) {
    .folders { grid-template-columns: 1fr; }
    .folder { aspect-ratio: 3 / 2; }
  }
</style>
