---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { filmProjects, photoAlbums, img } from '../../data/work';

const folders = [
  { href: '/work/video', title: 'Video', meta: 'Film · Commercial · Social', cover: img(filmProjects[0].cover), bw: true },
  { href: '/work/photography', title: 'Photography', meta: 'Studio · Portraits · Automotive · Event', cover: photoAlbums[0].cover, bw: false },
];
---

<BaseLayout title="Work" description="Selected work by TG Visuals — video and photography.">
  <section class="work-landing">
    <div class="container">
      <p class="eyebrow" data-reveal>Work</p>
      <h1 class="work-landing__title" data-reveal style="--reveal-delay:.05s">Selected work</h1>

      <div class="folders">
        {
          folders.map((f, i) => (
            <a href={f.href} class:list={['folder', { 'folder--bw': f.bw }]} data-reveal style={`--reveal-delay:${0.08 + i * 0.06}s`}>
              <div class="folder__media">
                <Image src={f.cover} alt={f.title} widths={[600, 900, 1300]} sizes="(max-width:760px) 100vw, 50vw" class="folder__img" loading="eager" />
              </div>
              <div class="folder__row">
                <span class="folder__title">{f.title}</span>
                <span class="folder__arrow" aria-hidden="true">↗</span>
              </div>
              <span class="folder__meta">{f.meta}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .work-landing {
    padding-top: calc(var(--nav-h) + var(--space-l));
    padding-bottom: var(--space-xl);
  }
  .work-landing__title {
    font-size: var(--step-2);
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0.3em 0 var(--space-l);
  }
  .folders {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-m);
  }
  .folder { display: block; }
  .folder__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--charcoal);
  }
  .folder__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.03);
    transition: transform 1.1s var(--ease);
  }
  .folder:hover .folder__img { transform: scale(1.04); }
  .folder__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 0.9em;
  }
  .folder__title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .folder__arrow {
    color: var(--smoke-dim);
    transition: transform var(--dur) var(--ease);
  }
  .folder:hover .folder__arrow { transform: translate(4px, -4px); }
  .folder__meta {
    display: block;
    margin-top: 0.3em;
    font-size: var(--step--1);
    color: var(--smoke-dim);
  }
  @media (max-width: 760px) {
    .folders { grid-template-columns: 1fr; }
  }
</style>
