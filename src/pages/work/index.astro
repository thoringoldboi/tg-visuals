---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { films, socialVideos, photoAlbums, youTubeId } from '../../data/work';

// Video unlocks automatically once a YouTube link is added in work.ts.
const videoReady = films.length + socialVideos.length > 0;
const filmId = films[0] ? youTubeId(films[0].url) : '';
const videoThumb = filmId ? `https://i.ytimg.com/vi/${filmId}/maxresdefault.jpg` : '';
const photoCover = photoAlbums.find((a) => a.slug === 'automotive')?.cover ?? photoAlbums[0]?.cover;
---

<BaseLayout title="Work" description="Selected work by TG Visuals — video and photography.">
  <section class="work-landing">
    <div class="container">
      <p class="eyebrow" data-reveal>Work</p>
      <h1 class="work-landing__title" data-reveal style="--reveal-delay:.05s">Selected work</h1>

      <div class="folders">
        {videoReady ? (
          <a href="/work/video" class="folder">
            <div class="folder__media">
              {videoThumb && <img src={videoThumb} alt="" class="folder__img" loading="lazy" />}
            </div>
            <div class="folder__body">
              <span class="folder__text">
                <span class="folder__title">Video</span>
                <span class="folder__meta">Film · Commercial · Social</span>
              </span>
              <span class="folder__arrow" aria-hidden="true">↗</span>
            </div>
          </a>
        ) : (
          <div class="folder folder--soon" aria-disabled="true">
            <div class="folder__media folder__media--empty">
              <span class="folder__badge"><span aria-hidden="true">🚧</span> Coming soon</span>
            </div>
            <div class="folder__body">
              <span class="folder__text">
                <span class="folder__title">Video</span>
                <span class="folder__meta">Film · Commercial · Social</span>
              </span>
            </div>
          </div>
        )}

        <a href="/work/photography" class="folder">
          <div class="folder__media">
            <Image src={photoCover} alt="" widths={[600, 900, 1300]} sizes="(max-width: 760px) 100vw, 50vw" class="folder__img" loading="lazy" />
          </div>
          <div class="folder__body">
            <span class="folder__text">
              <span class="folder__title">Photography</span>
              <span class="folder__meta">Studio · Portraits · Automotive</span>
            </span>
            <span class="folder__arrow" aria-hidden="true">↗</span>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .work-landing {
    padding-top: calc(var(--nav-h) + var(--space-l));
    padding-bottom: var(--space-xl);
  }
  .work-landing__title {
    font-size: var(--step-2);
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0.3em 0 var(--space-l);
  }
  .folders {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-m);
  }
  .folder { display: block; color: inherit; }
  .folder__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--charcoal);
  }
  .folder__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease);
  }
  .folder:hover .folder__img { transform: scale(1.045); }
  .folder__body {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    margin-top: 1em;
    padding-bottom: 1em;
    border-bottom: 1px solid var(--line-soft);
  }
  .folder__text { display: flex; flex-direction: column; gap: 0.2em; }
  .folder__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-2);
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .folder__meta { font-size: var(--step--1); color: var(--smoke-dim); }
  .folder__arrow {
    color: var(--smoke-dim);
    font-size: var(--step-1);
    transition: transform var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .folder:hover .folder__arrow { transform: translate(4px, -4px); color: var(--ink); }

  /* Coming-soon fallback (only if no videos are added yet) */
  .folder--soon { cursor: not-allowed; }
  .folder__media--empty {
    display: grid;
    place-items: center;
    background: var(--paper-2);
    border: 1px dashed var(--line);
  }
  .folder__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.4em 0.9em;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--paper);
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--smoke);
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .folders { grid-template-columns: 1fr; }
  }
</style>
