---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Lightbox from '../../components/Lightbox.astro';
import { photography, img } from '../../data/work';
---

<BaseLayout
  title="Photography"
  description="Product, studio, commercial, lifestyle and creative photography by TG Visuals."
>
  <PageHeader
    eyebrow="Photography"
    title="Stills with a cinematic eye"
    intro="Shaped light and considered composition across product, studio, commercial, lifestyle and creative work."
  />

  <!-- Category navigation -->
  <nav class="cat-nav" aria-label="Photography categories">
    <div class="container cat-nav__inner">
      {
        photography.map((c) => (
          <a href={`#${c.slug}`} class="cat-nav__link" data-cat-link={c.slug}>
            {c.title}
          </a>
        ))
      }
    </div>
  </nav>

  <div class="container">
    {
      photography.map((cat) => (
        <section class="photo-cat" id={cat.slug} data-cat-section={cat.slug}>
          <div class="photo-cat__head" data-reveal>
            <h2 class="photo-cat__title">{cat.title}</h2>
            <p class="photo-cat__blurb muted">{cat.blurb}</p>
          </div>
          <div class="photo-grid" data-lightbox-group>
            {cat.images.map((name, i) => (
              <figure class="photo-grid__item" data-reveal style={`--reveal-delay:${(i % 3) * 0.05}s`}>
                <Image
                  src={img(name)}
                  alt={`${cat.title} photography ${i + 1}`}
                  data-caption={`${cat.title} — ${String(i + 1).padStart(2, '0')}`}
                  widths={[400, 700, 1100]}
                  sizes="(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 33vw"
                  class="photo-grid__img"
                />
              </figure>
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <Lightbox />
</BaseLayout>

<style>
  .cat-nav {
    position: sticky;
    top: var(--nav-h);
    z-index: 40;
    background: color-mix(in srgb, var(--paper) 85%, transparent);
    backdrop-filter: blur(12px);
    border-block: 1px solid var(--line-soft);
    margin-bottom: var(--space-l);
  }
  .cat-nav__inner {
    display: flex;
    gap: 0.5em;
    overflow-x: auto;
    padding-block: 0.9em;
    scrollbar-width: none;
  }
  .cat-nav__inner::-webkit-scrollbar { display: none; }
  .cat-nav__link {
    flex: 0 0 auto;
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--smoke);
    padding: 0.45em 1em;
    border-radius: 999px;
    border: 1px solid transparent;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .cat-nav__link:hover { color: var(--ink); }
  .cat-nav__link.is-active {
    color: var(--ink);
    border-color: var(--red);
  }

  .photo-cat {
    padding-block: var(--space-l);
    scroll-margin-top: calc(var(--nav-h) + 60px);
  }
  .photo-cat__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-m);
    flex-wrap: wrap;
    margin-bottom: var(--space-m);
    padding-bottom: var(--space-s);
    border-bottom: 1px solid var(--line-soft);
  }
  .photo-cat__title {
    font-size: var(--step-3);
    letter-spacing: -0.03em;
  }
  .photo-cat__blurb { max-width: 44ch; }

  /* Masonry via CSS columns */
  .photo-grid {
    columns: 3;
    column-gap: var(--space-s);
  }
  .photo-grid__item {
    break-inside: avoid;
    margin-bottom: var(--space-s);
    border-radius: var(--radius-media);
    overflow: hidden;
    background: var(--charcoal);
  }
  .photo-grid__img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.9s var(--ease), filter 0.6s var(--ease);
  }
  .photo-grid__img:hover {
    transform: scale(1.03);
    filter: brightness(1.05);
  }
  @media (max-width: 1000px) {
    .photo-grid { columns: 2; }
  }
  @media (max-width: 560px) {
    .photo-grid { columns: 1; }
  }
</style>

<script>
  // Highlight the category nav link for the section in view.
  const links = document.querySelectorAll<HTMLElement>('[data-cat-link]');
  const sections = document.querySelectorAll<HTMLElement>('[data-cat-section]');
  const map = new Map<string, HTMLElement>();
  links.forEach((l) => map.set(l.dataset.catLink!, l));

  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          links.forEach((l) => l.classList.remove('is-active'));
          map.get((e.target as HTMLElement).dataset.catSection!)?.classList.add('is-active');
        }
      });
    },
    { rootMargin: '-30% 0px -60% 0px' }
  );
  sections.forEach((s) => io.observe(s));
</script>
