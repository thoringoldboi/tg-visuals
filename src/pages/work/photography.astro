---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { photoAlbums } from '../../data/work';
---

<BaseLayout title="Photography — Work" description="Photography albums by TG Visuals — studio, automotive, event and product.">
  <section class="work-sub">
    <div class="container">
      <nav class="crumbs" data-reveal>
        <a href="/work">Work</a> <span aria-hidden="true">/</span> <span class="crumbs__here">Photography</span>
      </nav>
      <h1 class="work-sub__title" data-reveal style="--reveal-delay:.05s">Photography</h1>

      <div class="albums">
        {
          photoAlbums.map((a, i) => (
            <a href={`/work/photography/${a.slug}`} class="album" data-reveal style={`--reveal-delay:${0.08 + i * 0.05}s`}>
              <div class="album__media">
                <Image src={a.cover} alt={a.title} widths={[500, 800]} sizes="(max-width:640px) 100vw, 50vw" class="album__img" loading="lazy" />
              </div>
              <div class="album__row">
                <span class="album__title">{a.title}</span>
                <span class="album__count">{a.images.length}</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .work-sub { padding-top: calc(var(--nav-h) + var(--space-l)); padding-bottom: var(--space-2xl); }
  .crumbs { font-family: var(--font-display); font-size: var(--step--1); letter-spacing: 0.02em; color: var(--smoke-dim); display: flex; gap: 0.5em; }
  .crumbs a { color: var(--smoke); }
  .crumbs a:hover { color: var(--ink); }
  .crumbs__here { color: var(--ink); }
  .work-sub__title { font-size: var(--step-4); letter-spacing: -0.035em; line-height: 1; margin: 0.25em 0 var(--space-xl); }

  .albums { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-m); }
  .album { display: block; }
  .album__media { aspect-ratio: 4 / 3; overflow: hidden; background: var(--charcoal); }
  .album__img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s var(--ease); }
  .album:hover .album__img { transform: scale(1.04); }
  .album__row { display: flex; align-items: baseline; justify-content: space-between; margin-top: 0.8em; padding-bottom: 0.8em; border-bottom: 1px solid var(--line-soft); }
  .album__title { font-family: var(--font-display); font-size: var(--step-1); font-weight: 600; letter-spacing: -0.02em; }
  .album__count { font-size: var(--step--1); color: var(--smoke-dim); }
  @media (max-width: 640px) { .albums { grid-template-columns: 1fr; } }
</style>
