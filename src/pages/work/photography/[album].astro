---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { photoAlbums } from '../../../data/work';

export function getStaticPaths() {
  return photoAlbums.map((album) => ({
    params: { album: album.slug },
    props: { album },
  }));
}

const { album } = Astro.props;

// The cover leads the page as the hero; the rest fill the gallery.
const galleryImages =
  album.images.length > 1 ? album.images.filter((im) => im !== album.cover) : album.images;

// Large versions for the click-to-enlarge lightbox.
const larges = await Promise.all(
  galleryImages.map((src) => getImage({ src, width: 2000, format: 'webp' }))
);
---

<BaseLayout title={`${album.title} — Photography`} description={`${album.title} photography by TG Visuals.`}>
  <!-- Parallax hero -->
  <header class="album-hero">
    <div class="album-hero__media" data-parallax>
      <Image src={album.cover} alt={album.title} widths={[1200, 1800, 2400]} sizes="100vw" class="album-hero__img" loading="eager" />
    </div>
    <div class="album-hero__scrim" aria-hidden="true"></div>
    <div class="album-hero__inner container">
      <nav class="crumbs">
        <a href="/work">Work</a> <span aria-hidden="true">/</span>
        <a href="/work/photography">Photography</a>
      </nav>
      <h1 class="album-hero__title">{album.title}</h1>
    </div>
  </header>

  <section class="work-sub">
    <div class="container">
      <div class="gallery">
        {
          galleryImages.map((image, i) => (
            <button class="photo" type="button" data-full={larges[i].src} aria-label={`Enlarge ${album.title} photo ${i + 1}`}>
              <Image src={image} alt={`${album.title} ${i + 1}`} widths={[240, 360, 520]} sizes="(max-width:680px) 45vw, (max-width:1000px) 30vw, 22vw" class="photo__img" loading="lazy" />
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Lightbox -->
  <div class="lb" data-lightbox hidden>
    <button class="lb__close" type="button" aria-label="Close">&times;</button>
    <img class="lb__img" alt="" />
  </div>
</BaseLayout>

<style>
  /* Parallax hero */
  .album-hero {
    position: relative;
    margin-top: var(--nav-h);
    height: clamp(340px, 58vh, 620px);
    overflow: hidden;
    background: var(--ink);
  }
  .album-hero__media {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 124%;
    will-change: transform;
  }
  .album-hero__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .album-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.28) 0%, rgba(0, 0, 0, 0) 30%, rgba(0, 0, 0, 0.55) 100%);
  }
  .album-hero__inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: var(--space-l);
    padding-bottom: var(--space-l);
    color: #fff;
  }
  .album-hero__inner .crumbs {
    font-family: var(--font-display);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    display: flex;
    gap: 0.5em;
    color: rgba(255, 255, 255, 0.75);
  }
  .album-hero__inner .crumbs a { color: rgba(255, 255, 255, 0.75); }
  .album-hero__inner .crumbs a:hover { color: #fff; }
  .album-hero__title {
    font-size: var(--step-5);
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: #fff;
  }

  .work-sub { padding-top: var(--space-l); padding-bottom: var(--space-2xl); }

  /* Masonry columns — small thumbnails */
  .gallery { column-count: 4; column-gap: var(--space-s); }
  .photo {
    display: block;
    width: 100%;
    margin: 0 0 var(--space-s);
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    break-inside: avoid;
    overflow: hidden;
  }
  .photo__img { width: 100%; height: auto; display: block; transition: opacity var(--dur) var(--ease); }
  .photo:hover .photo__img { opacity: 0.86; }
  @media (max-width: 1000px) { .gallery { column-count: 3; } }
  @media (max-width: 680px) { .gallery { column-count: 2; } }

  /* Lightbox */
  .lb {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 4vw, 3rem);
    background: rgba(8, 8, 9, 0.94);
    cursor: zoom-out;
  }
  .lb[hidden] { display: none; }
  .lb__img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    cursor: default;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }
  .lb__close {
    position: absolute;
    top: clamp(0.8rem, 2vw, 1.6rem);
    right: clamp(0.8rem, 2vw, 1.6rem);
    width: 2.4rem;
    height: 2.4rem;
    display: grid;
    place-items: center;
    background: none;
    border: 0;
    color: #fff;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0.8;
  }
  .lb__close:hover { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .album-hero__media { transform: none !important; }
  }
</style>

<script>
  // Subtle parallax on the album hero image.
  const media = document.querySelector<HTMLElement>('[data-parallax]');
  const hero = media?.closest<HTMLElement>('.album-hero');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (media && hero && !reduce) {
    let ticking = false;
    const update = () => {
      const offset = Math.max(0, -hero.getBoundingClientRect().top);
      const shift = -Math.min(offset * 0.14, hero.offsetHeight * 0.1);
      media.style.transform = `translate3d(0, ${shift}px, 0)`;
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true }
    );
    update();
  }

  // Click-to-enlarge lightbox.
  const lb = document.querySelector<HTMLElement>('[data-lightbox]');
  const lbImg = lb?.querySelector<HTMLImageElement>('.lb__img');
  if (lb && lbImg) {
    const open = (src: string) => {
      lbImg.src = src;
      lb.hidden = false;
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      lb.hidden = true;
      lbImg.removeAttribute('src');
      document.body.style.overflow = '';
    };
    document.querySelectorAll<HTMLButtonElement>('.photo[data-full]').forEach((btn) => {
      btn.addEventListener('click', () => open(btn.dataset.full!));
    });
    lb.addEventListener('click', (e) => {
      if (e.target !== lbImg) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lb.hidden) close();
    });
  }
</script>
