---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { photoAlbums } from '../../../data/work';

export function getStaticPaths() {
  return photoAlbums.map((album) => ({
    params: { album: album.slug },
    props: { album },
  }));
}

const { album } = Astro.props;
---

<BaseLayout title={`${album.title} — Photography`} description={`${album.title} photography by TG Visuals.`}>
  <section class="work-sub">
    <div class="container">
      <nav class="crumbs" data-reveal>
        <a href="/work">Work</a> <span aria-hidden="true">/</span>
        <a href="/work/photography">Photography</a> <span aria-hidden="true">/</span>
        <span class="crumbs__here">{album.title}</span>
      </nav>
      <h1 class="work-sub__title" data-reveal style="--reveal-delay:.05s">{album.title}</h1>

      <div class="gallery">
        {
          album.images.map((image) => (
            <div class="photo" data-reveal>
              <Image src={image} alt={album.title} widths={[400, 800, 1200]} sizes="(max-width:640px) 100vw, 50vw" class="photo__img" loading="lazy" />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .work-sub { padding-top: calc(var(--nav-h) + var(--space-l)); padding-bottom: var(--space-2xl); }
  .crumbs { font-family: var(--font-display); font-size: var(--step--1); letter-spacing: 0.02em; color: var(--smoke-dim); display: flex; flex-wrap: wrap; gap: 0.5em; }
  .crumbs a { color: var(--smoke); }
  .crumbs a:hover { color: var(--ink); }
  .crumbs__here { color: var(--ink); }
  .work-sub__title { font-size: var(--step-4); letter-spacing: -0.035em; line-height: 1; margin: 0.25em 0 var(--space-xl); }

  .gallery { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-m) var(--space-s); }
  .photo { overflow: hidden; background: var(--charcoal); }
  .photo__img { width: 100%; height: auto; display: block; filter: grayscale(1) contrast(1.03); transition: transform 1.1s var(--ease); }
  .photo:hover .photo__img { transform: scale(1.03); }
  @media (max-width: 640px) { .gallery { grid-template-columns: 1fr; } }
</style>
