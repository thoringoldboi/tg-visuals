---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you're looking for doesn't exist.">
  <section class="notfound">
    <div class="notfound__glow" aria-hidden="true"></div>
    <div class="container notfound__inner">
      <p class="eyebrow">Error 404</p>
      <h1 class="notfound__title">This scene didn’t<br /><span class="serif-accent">make the cut.</span></h1>
      <p class="notfound__text muted">The page you’re looking for has moved or never existed.</p>
      <div class="notfound__actions">
        <a href="/" class="btn btn--red">Back to home <span class="btn__arrow" aria-hidden="true">↗</span></a>
        <a href="/work" class="btn btn--ghost">View work</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    position: relative;
    min-height: 82svh;
    display: grid;
    align-items: center;
    padding-top: var(--nav-h);
    overflow: hidden;
  }
  .notfound__glow {
    position: absolute;
    inset: 0;
    background: var(--grad-crimson-soft);
    z-index: -1;
  }
  .notfound__title {
    font-size: var(--step-4);
    letter-spacing: -0.035em;
    line-height: 0.98;
    margin: 0.3em 0 0.5em;
  }
  .notfound__text { max-width: 40ch; }
  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8em;
    margin-top: 2em;
  }
</style>
