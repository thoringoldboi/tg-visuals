---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact } from '../config/site';
---

<BaseLayout
  title="Contact"
  description="Start a project with TG Visuals — tell me about it and I'll get back to you."
>
  <section class="contact">
    <div class="container contact__inner">
      <p class="eyebrow" data-reveal>Contact</p>
      <h1 class="contact__title" data-reveal style="--reveal-delay:.05s">
        Want to chat about a project?
      </h1>
      <p class="contact__lede" data-reveal style="--reveal-delay:.1s">
        Tell me a bit about what you have in mind — the idea, timeline and anything
        you’ve got so far. I’ll get back to you within a couple of days.
      </p>

      <form class="form" data-contact-form novalidate data-reveal style="--reveal-delay:.14s">
        <div class="field">
          <label for="name">Name <span class="req">*</span></label>
          <input type="text" id="name" name="name" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="email">Email address <span class="req">*</span></label>
          <input type="email" id="email" name="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="message">Tell me about the project <span class="req">*</span></label>
          <textarea id="message" name="message" rows="7" required></textarea>
        </div>

        <!-- FormSubmit settings + spam trap -->
        <input type="hidden" name="_subject" value="New project enquiry — TG Visuals" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_template" value="table" />
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="visually-hidden" aria-hidden="true" />

        <div class="form__submit">
          <button type="submit" class="btn">
            Submit <span class="btn__arrow" aria-hidden="true">↗</span>
          </button>
          <p class="form__status" data-status role="status" aria-live="polite"></p>
        </div>
      </form>

      <p class="contact__alt">
        Prefer email? <a href={`mailto:${contact.email}`} class="link-underline">{contact.email}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    padding-top: calc(var(--nav-h) + var(--space-xl));
    padding-bottom: var(--space-2xl);
  }
  .contact__inner { max-width: 720px; }
  .contact__title {
    font-size: clamp(1.15rem, 4.7vw, 2.5rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    white-space: nowrap;
    margin: 0.3em 0 0.6em;
  }
  .contact__lede {
    color: var(--smoke);
    max-width: 52ch;
    line-height: 1.6;
    margin-bottom: var(--space-l);
  }

  .form { display: grid; gap: var(--space-m); }
  .field { display: grid; gap: 0.6em; }
  label {
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .req { color: var(--smoke-dim); }
  input,
  textarea {
    width: 100%;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--ink);
    padding: 0.85em 1em;
    font-size: var(--step-0);
    transition: border-color var(--dur) var(--ease);
  }
  textarea { resize: vertical; min-height: 160px; }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--ink);
  }
  input:user-invalid,
  textarea:user-invalid { border-color: #b00020; }

  .form__submit {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    flex-wrap: wrap;
    margin-top: var(--space-2xs);
  }
  .form__status { font-size: var(--step--1); color: var(--smoke); }
  .form__status[data-state='error'] { color: #b00020; }
  .form__status[data-state='success'] { color: var(--ink); }

  .contact__alt {
    margin-top: var(--space-l);
    color: var(--smoke);
    font-size: var(--step--1);
  }
  .contact__alt a { color: var(--ink); }
</style>

<script>
  import { contact } from '../config/site';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-status]');

  function setStatus(msg: string, state: '' | 'error' | 'success') {
    if (!status) return;
    status.textContent = msg;
    status.dataset.state = state;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      setStatus('Please complete the required fields.', 'error');
      form.reportValidity();
      return;
    }
    // Honeypot: silently ignore bots.
    if ((form.elements.namedItem('_honey') as HTMLInputElement)?.value) return;

    const data = new FormData(form);
    const endpoint = contact.formEndpoint;

    if (endpoint) {
      setStatus('Sending…', '');
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          form.reset();
          setStatus('Thanks — your message is on its way. I’ll be in touch soon.', 'success');
        } else {
          throw new Error('Bad response');
        }
      } catch {
        setStatus('Something went wrong. Please email me directly instead.', 'error');
      }
    } else {
      // No endpoint set yet → open the visitor's email client, pre-filled.
      const name = String(data.get('name') || '');
      const email = String(data.get('email') || '');
      const message = String(data.get('message') || '');
      const subject = encodeURIComponent(`New project enquiry — ${name}`);
      const body = encodeURIComponent(`Name: ${name}\nEmail: ${email}\n\n${message}`);
      window.location.href = `mailto:${contact.email}?subject=${subject}&body=${body}`;
      setStatus('Opening your email app…', 'success');
    }
  });
</script>
