---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { filmProjects, photoAlbums, img } from '../data/work';
import heroPoster from '../assets/work/hero-poster.jpg';
import markWhite from '../assets/brand/tg-mark-white.png';

// Curated best-of for the home page — the full library lives on /work.
const selected = [
  ...filmProjects.map((p) => ({ src: img(p.cover), title: p.title, meta: p.category })),
  ...photoAlbums.map((a) => ({ src: a.cover, title: a.title, meta: 'Photography' })),
].slice(0, 6);
---

<BaseLayout overlayHeader>
  <!-- ============================ HERO ============================ -->
  <section class="hero" id="top" aria-label="Showreel">
    <!-- Placeholder still (desaturated). Your real showreel plays on top of it. -->
    <Image src={heroPoster} alt="" class="hero__poster" widths={[960, 1440, 1920]} sizes="100vw" loading="eager" />
    <video class="hero__video" autoplay muted loop playsinline preload="metadata">
      <!-- Drop your showreel at /public/showreel.mp4 (and optional .webm). -->
      <source src="/showreel.webm" type="video/webm" />
      <source src="/showreel.mp4" type="video/mp4" />
    </video>
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="hero__center">
      <div class="hero__lockup">
        <Image src={markWhite} alt="TG Visuals" width={506} densities={[1, 2]} class="hero__logo" />
        <span class="hero__word">VISUALS</span>
      </div>
    </div>

    <a href="#work" class="hero__scroll" aria-label="Scroll to work">
      <span>Scroll</span>
      <span class="hero__scroll-line" aria-hidden="true"></span>
    </a>
  </section>

  <!-- ============================ WORK ============================ -->
  <section class="section work" id="work">
    <div class="container">
      <header class="work__head">
        <h2 class="work__title">Selected work</h2>
        <a href="/work" class="link-underline work__ig">
          All work <span aria-hidden="true">↗</span>
        </a>
      </header>

      <div class="work__grid">
        {
          selected.map((p) => (
            <figure class="tile" data-reveal>
              <div class="tile__media">
                <Image
                  src={p.src}
                  alt={`${p.title} — ${p.meta}`}
                  widths={[400, 700, 1000]}
                  sizes="(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 33vw"
                  class="tile__img"
                  loading="lazy"
                />
              </div>
              <figcaption class="tile__cap">
                <span class="tile__name">{p.title}</span>
                <span class="tile__meta">{p.meta}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---------------- Hero (full-screen showreel) ---------------- */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: #000;
  }
  .hero__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    z-index: 0;
  }
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: transparent;
    z-index: 1;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.42);
    z-index: 2;
  }
  .hero__center { z-index: 3; }
  .hero__scroll { z-index: 3; }
  .hero__center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.1rem;
    padding: var(--gutter);
    text-align: center;
  }
  .hero__lockup {
    display: flex;
    align-items: center;
    gap: clamp(0.7rem, 1.4vw, 1.1rem);
    filter: drop-shadow(0 4px 30px rgba(0, 0, 0, 0.35));
  }
  .hero__logo {
    width: auto;
    height: clamp(42px, 5vw, 68px);
  }
  .hero__word {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.25rem, 1rem + 1.6vw, 2rem);
    letter-spacing: 0.34em;
    text-indent: 0.34em;
    text-transform: uppercase;
    color: #fff;
  }
  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: var(--space-m);
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7em;
    font-family: var(--font-display);
    font-size: 0.68rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
  }
  .hero__scroll-line {
    width: 1px;
    height: 46px;
    background: rgba(255, 255, 255, 0.6);
    animation: scrollpulse 2.2s var(--ease) infinite;
    transform-origin: top;
  }
  @keyframes scrollpulse {
    0%, 100% { transform: scaleY(0.4); opacity: 0.4; }
    50% { transform: scaleY(1); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-line { animation: none; }
  }

  /* ---------------- Work / portfolio ---------------- */
  .work__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-m);
    margin-bottom: var(--space-l);
    flex-wrap: wrap;
  }
  .work__title {
    font-size: var(--step-3);
    letter-spacing: -0.03em;
  }
  .work__ig { color: var(--smoke); white-space: nowrap; }
  .work__ig:hover { color: var(--ink); }
  .work__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-m) var(--space-s);
  }
  .tile { margin: 0; }
  .tile__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--charcoal);
  }
  .tile__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Desaturated for the black-and-white look. Remove this filter to show
       real work in full colour. */
    filter: grayscale(1) contrast(1.03);
    transition: transform 1.1s var(--ease);
  }
  .tile:hover .tile__img {
    transform: scale(1.045);
  }
  .tile__cap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    margin-top: 0.9em;
    padding-bottom: 0.9em;
    border-bottom: 1px solid var(--line-soft);
  }
  .tile__name {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .tile__meta {
    font-size: var(--step--1);
    color: var(--smoke-dim);
    white-space: nowrap;
  }
  @media (max-width: 900px) {
    .work__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .work__grid { grid-template-columns: 1fr; }
  }
</style>
