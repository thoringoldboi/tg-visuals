---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { photoAlbums, films, youTubeId } from '../data/work';
import heroPoster from '../assets/work/hero-poster.jpg';
import markWhite from '../assets/brand/tg-mark-white.png';

// Two lanes under the hero: Video + Photography, each backed by real work.
const photoLane = photoAlbums.find((a) => a.slug === 'automotive')?.cover ?? photoAlbums[0]?.cover;
const filmId = films[0] ? youTubeId(films[0].url) : '';
const videoThumb = filmId ? `https://i.ytimg.com/vi/${filmId}/maxresdefault.jpg` : '';
---

<BaseLayout overlayHeader>
  <!-- ============================ HERO ============================ -->
  <section class="hero" id="top" aria-label="Showreel">
    <!-- Placeholder still (desaturated). Your real showreel plays on top of it. -->
    <Image src={heroPoster} alt="" class="hero__poster" widths={[960, 1440, 1920]} sizes="100vw" loading="eager" />
    <video class="hero__video" autoplay muted loop playsinline preload="metadata">
      <!-- Drop your showreel at /public/showreel.mp4 (and optional .webm). -->
      <source src="/showreel.webm" type="video/webm" />
      <source src="/showreel.mp4" type="video/mp4" />
    </video>
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="hero__center">
      <div class="hero__lockup">
        <Image src={markWhite} alt="TG Visuals" width={506} densities={[1, 2]} class="hero__logo" />
        <span class="hero__word">VISUALS</span>
      </div>
    </div>
  </section>

  <!-- ============================ LANES ============================ -->
  <section class="section lanes" id="work" aria-label="Explore work">
    <div class="container">
      <div class="lanes__grid">
        <a class="lane" href="/work/video" data-reveal>
          <div class="lane__media">
            {videoThumb && <img src={videoThumb} alt="" class="lane__img" loading="lazy" />}
          </div>
          <div class="lane__body">
            <span class="lane__text">
              <span class="lane__title">Video</span>
              <span class="lane__meta">Film · Commercial · Social</span>
            </span>
            <span class="lane__arrow" aria-hidden="true">↗</span>
          </div>
        </a>

        <a class="lane" href="/work/photography" data-reveal style="--reveal-delay:.06s">
          <div class="lane__media">
            <Image src={photoLane} alt="" widths={[600, 900, 1300]} sizes="(max-width: 760px) 100vw, 50vw" class="lane__img" loading="lazy" />
          </div>
          <div class="lane__body">
            <span class="lane__text">
              <span class="lane__title">Photography</span>
              <span class="lane__meta">Studio · Portraits · Automotive</span>
            </span>
            <span class="lane__arrow" aria-hidden="true">↗</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================ CTA ============================ -->
  <section class="cta">
    <div class="container cta__inner">
      <p class="cta__eyebrow">Available for work</p>
      <h2 class="cta__title">Let's create something.</h2>
      <a href="/contact" class="btn cta__btn">
        Start a project <span class="btn__arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---------------- Hero (full-screen showreel) ---------------- */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: #000;
    isolation: isolate; /* contain the logo's blend to the hero (blend vs video) */
  }
  /* On phones the landscape showreel is heavily side-cropped by object-fit:cover.
     A slightly shorter hero reduces that crop (shows more of the frame) without
     introducing letterbox bars. */
  @media (max-width: 560px) {
    .hero {
      height: 84svh;
      min-height: 460px;
    }
  }
  .hero__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    z-index: 0;
  }
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: transparent;
    z-index: 1;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.2);
    z-index: 2;
  }
  .hero__center { z-index: 3; }
  .hero__center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.1rem;
    padding: var(--gutter);
    text-align: center;
    /* Invert/blend against the video behind it instead of stark white */
    mix-blend-mode: difference;
  }
  .hero__lockup {
    display: flex;
    align-items: center;
    gap: clamp(0.55rem, 1.1vw, 0.85rem);
  }
  .hero__logo {
    width: auto;
    height: clamp(30px, 3.5vw, 48px);
  }
  .hero__word {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(0.82rem, 0.72rem + 0.6vw, 1.2rem);
    letter-spacing: 0.3em;
    text-indent: 0.3em;
    text-transform: uppercase;
    color: #fff;
  }
  /* ---------------- Lanes (Video / Photography) ---------------- */
  .lanes__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-m);
  }
  .lane { display: block; color: inherit; }
  .lane__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--charcoal);
  }
  .lane__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease);
  }
  .lane:hover .lane__img { transform: scale(1.045); }
  .lane__body {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    margin-top: 1em;
    padding-bottom: 1em;
    border-bottom: 1px solid var(--line-soft);
  }
  .lane__text { display: flex; flex-direction: column; gap: 0.2em; }
  .lane__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-2);
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .lane__meta { font-size: var(--step--1); color: var(--smoke-dim); }
  .lane__arrow {
    color: var(--smoke-dim);
    font-size: var(--step-1);
    transition: transform var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .lane:hover .lane__arrow { transform: translate(4px, -4px); color: var(--ink); }
  @media (max-width: 640px) {
    .lanes__grid { grid-template-columns: 1fr; gap: var(--space-l); }
    .lane__media { aspect-ratio: 4 / 3; }
  }

  /* ---------------- CTA ---------------- */
  .cta {
    padding-block: var(--space-2xl);
    border-top: 1px solid var(--line-soft);
    text-align: center;
  }
  .cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-s);
  }
  .cta__eyebrow {
    font-family: var(--font-display);
    font-size: var(--step--1);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--smoke-dim);
    margin: 0;
  }
  .cta__title {
    font-size: var(--step-3);
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0;
  }
  .cta__btn { margin-top: var(--space-xs); }
</style>
