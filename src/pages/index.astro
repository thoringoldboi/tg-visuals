---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FilmCard from '../components/FilmCard.astro';
import { films, services, testimonials, social, img } from '../data/work';
import { site, contact, ctaLabel } from '../config/site';
import portrait from '../assets/portrait/thor-portrait.jpg';

const featured = films.filter((f) => f.featured).slice(0, 4);
const socialClips = social.slice(0, 5);

const disciplines = ['Video', 'Photography', 'Social Content', 'Creative Direction'];

const whyPoints = [
  { title: 'Stops the scroll', body: 'A strong first frame earns the next three seconds — the whole game on social.' },
  { title: 'Builds desire', body: 'Light, pace and framing that make a product or brand feel worth having.' },
  { title: 'Communicates value', body: 'Every cut is working to say something, not just to look expensive.' },
  { title: 'Drives action', body: 'Content shaped around the result — a follow, a booking, a sale.' },
];

const process = [
  { no: '01', title: 'Discover', body: 'Understand the brand, the audience and what the content actually needs to do.' },
  { no: '02', title: 'Create', body: 'Develop the concept, visual direction and a production plan built for the platform.' },
  { no: '03', title: 'Produce', body: 'Film, photograph and direct the shoot — calm on set, precise in the details.' },
  { no: '04', title: 'Deliver', body: 'Edit, grade and hand over content that’s ready to publish and built to perform.' },
];
---

<BaseLayout>
  <!-- ============================ HERO ============================ -->
  <section class="hero">
    <div class="container">
      <div class="hero__head">
        <p class="eyebrow" data-reveal>Video · Photography · Social Content</p>
        <h1 class="hero__title" data-reveal style="--reveal-delay:.05s">
          Visuals that<br />look premium.<br />
          <span class="serif-accent">Content that performs.</span>
        </h1>
        <div class="hero__aside" data-reveal style="--reveal-delay:.12s">
          <p class="hero__lede">
            TG Visuals creates cinematic video, photography and social-first content
            for brands and businesses that care how they’re seen — and what that
            content actually does.
          </p>
          <div class="hero__actions">
            <a href="#work" class="btn btn--red">
              View selected work <span class="btn__arrow" aria-hidden="true">↗</span>
            </a>
            <a href="/contact" class="btn btn--ghost">{ctaLabel}</a>
          </div>
        </div>
      </div>

      <div class="hero__reel" id="showreel" data-reveal style="--reveal-delay:.1s">
        <VideoEmbed cover="hero-poster" label="Watch the showreel" eager sizes="(max-width:1520px) 100vw, 1520px" />
        <div class="hero__reel-caption">
          <span>Showreel</span>
          <span>2025 — TG Visuals</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== SOCIAL PROOF / STAT ===================== -->
  <section class="proof" aria-label="Credibility">
    <div class="container proof__grid">
      <div class="proof__stat" data-reveal>
        <span class="proof__num">{site.views}</span>
        <span class="proof__label">Views generated<br />across social platforms</span>
      </div>
      <ul class="proof__disciplines" data-reveal style="--reveal-delay:.08s">
        {disciplines.map((d) => <li>{d}</li>)}
      </ul>
    </div>
  </section>

  <!-- ======================== PHILOSOPHY ========================= -->
  <section class="section philosophy">
    <div class="container philosophy__grid">
      <p class="eyebrow" data-reveal>The difference</p>
      <h2 class="philosophy__statement" data-reveal style="--reveal-delay:.05s">
        A lot of content looks good.
        <span class="serif-accent">Very little of it actually does anything.</span>
      </h2>
      <div class="philosophy__body" data-reveal style="--reveal-delay:.1s">
        <p>
          Beautiful footage is the baseline. The real work is content that earns
          attention and moves people — which means understanding the platform, the
          audience and the psychology of the scroll, not just the camera.
        </p>
        <p class="muted">
          TG Visuals sits at that intersection: high-end production and a genuine
          grasp of how content performs online. Premium craft, built around a result.
        </p>
      </div>
    </div>
  </section>

  <!-- ======================= SELECTED WORK ======================= -->
  <section class="section" id="work">
    <div class="container">
      <SectionHeading
        eyebrow="Selected Work"
        title="Recent films &amp; productions"
        href="/work"
        linkLabel="All projects"
      />
      <div class="work-editorial">
        <FilmCard film={featured[0]} index={1} variant="wide" sizes="(max-width:1520px) 100vw, 1520px" />
        {featured[1] && <FilmCard film={featured[1]} index={2} sizes="(max-width:900px) 100vw, 50vw" />}
        {featured[2] && <FilmCard film={featured[2]} index={3} sizes="(max-width:900px) 100vw, 50vw" />}
        {featured[3] && <FilmCard film={featured[3]} index={4} variant="wide" sizes="(max-width:1520px) 100vw, 1520px" />}
      </div>
      <p class="work-note muted">Sample projects shown — replaced with real work as it’s published.</p>
    </div>
  </section>

  <!-- ======================= WHY TG VISUALS ======================= -->
  <section class="section why">
    <div class="container why__grid">
      <div class="why__head" data-reveal>
        <p class="eyebrow">Why TG Visuals</p>
        <h2 class="why__title">
          Good content gets watched.<br />
          <span class="serif-accent">Great content gets remembered.</span>
        </h2>
        <p class="why__lede muted">
          The goal was never just cinematic footage. It’s content built to do a
          job — for the brand, the feed and the bottom line.
        </p>
      </div>
      <ul class="why__list">
        {
          whyPoints.map((p, i) => (
            <li class="why__item" data-reveal style={`--reveal-delay:${i * 0.06}s`}>
              <span class="why__no">/ 0{i + 1}</span>
              <h3 class="why__item-title">{p.title}</h3>
              <p class="why__item-body muted">{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ========================= SERVICES ========================== -->
  <section class="section services" id="services">
    <div class="container">
      <SectionHeading eyebrow="Services" title="What I make" />
      <div class="services-list">
        {
          services.map((s, i) => (
            <div class="service-row" data-reveal>
              <span class="service-row__no">0{i + 1}</span>
              <h3 class="service-row__title">{s.title}</h3>
              <p class="service-row__desc muted">{s.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- =================== SOCIAL / PERFORMANCE ==================== -->
  <section class="section performance">
    <div class="container">
      <div class="performance__grid">
        <div class="performance__head" data-reveal>
          <p class="eyebrow">Social &amp; Performance</p>
          <h2 class="performance__title">
            Made for the feed.<br /><span class="serif-accent">Built for attention.</span>
          </h2>
          <p class="performance__body muted">
            Every clip is made with the reality of the platform in mind — the hook,
            the first frame, retention and the reason someone shares it. Cinematic to
            look at, engineered to hold attention.
          </p>
          <div class="performance__stat">
            <span class="performance__num">{site.views}</span>
            <span class="performance__stat-label">views generated across social platforms</span>
          </div>
          <a href={contact.instagram.url} class="link-underline performance__link" target="_blank" rel="noopener">
            See it on Instagram <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="performance__reel" data-reveal style="--reveal-delay:.08s">
          {
            socialClips.map((clip) => (
              <figure class="clip">
                <Image
                  src={img(clip.cover)}
                  alt={`${clip.title} — ${clip.platform} ${clip.format}`}
                  widths={[240, 400]}
                  sizes="(max-width:720px) 60vw, 220px"
                  class="clip__img"
                  loading="lazy"
                />
                <figcaption class="clip__cap">{clip.platform} · {clip.format}</figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ========================= ABOUT ============================= -->
  <section class="about-teaser">
    <div class="container about-teaser__grid">
      <div class="about-teaser__media" data-reveal>
        <Image
          src={portrait}
          alt="Thorin Goldswain, the videographer and photographer behind TG Visuals"
          widths={[420, 640, 900]}
          sizes="(max-width: 900px) 100vw, 42vw"
          class="about-teaser__img"
        />
      </div>
      <div class="about-teaser__body" data-reveal style="--reveal-delay:.08s">
        <p class="eyebrow about-teaser__eyebrow">The person behind TG Visuals</p>
        <h2 class="about-teaser__lead">
          Behind the<br /><span class="serif-accent">camera.</span>
        </h2>
        <p class="about-teaser__intro">
          TG Visuals is Thorin Goldswain — one person running concept, shoot, edit
          and grade. Built on a simple belief: great production should earn its keep,
          not just look good.
        </p>
        <a href="/about" class="link-underline about-teaser__link">
          More about me <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ========================= PROCESS =========================== -->
  <section class="section process">
    <div class="container">
      <SectionHeading eyebrow="Process" title="How the work gets made" />
      <div class="process__grid">
        {
          process.map((step, i) => (
            <div class="process__step" data-reveal style={`--reveal-delay:${i * 0.06}s`}>
              <span class="process__no">{step.no}</span>
              <h3 class="process__title">{step.title}</h3>
              <p class="process__body muted">{step.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================= TESTIMONIALS ======================== -->
  {
    testimonials.length > 0 && (
      <section class="section testimonials">
        <div class="container">
          <p class="eyebrow" data-reveal>What clients say</p>
          <div class="testimonials__list">
            {testimonials.map((t) => (
              <figure class="testimonial" data-reveal>
                <blockquote class="testimonial__quote">“{t.quote}”</blockquote>
                <figcaption class="testimonial__by">
                  <span class="testimonial__name">{t.name}</span>
                  <span class="testimonial__role">{t.role}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* ---------------- Hero ---------------- */
  .hero {
    padding-top: calc(var(--nav-h) + var(--space-l));
    padding-bottom: var(--space-l);
  }
  .hero__head {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    grid-template-areas:
      'eyebrow eyebrow'
      'title   aside';
    gap: var(--space-s) var(--space-l);
    align-items: end;
  }
  .hero__head > .eyebrow { grid-area: eyebrow; }
  .hero__title {
    grid-area: title;
    font-size: clamp(2.7rem, 1.1rem + 6vw, 6.6rem);
    line-height: 0.92;
    letter-spacing: -0.035em;
  }
  .hero__aside { grid-area: aside; padding-bottom: 0.5em; }
  .hero__lede {
    color: var(--smoke);
    max-width: 42ch;
    font-size: var(--step-0);
    line-height: 1.55;
  }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.8em; margin-top: 1.6em; }
  .hero__reel { position: relative; margin-top: var(--space-l); }
  .hero__reel-caption {
    display: flex;
    justify-content: space-between;
    margin-top: 1em;
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--smoke-dim);
  }
  @media (max-width: 900px) {
    .hero__head {
      grid-template-columns: 1fr;
      grid-template-areas: 'eyebrow' 'title' 'aside';
      gap: var(--space-s);
    }
    .hero__title { font-size: clamp(2.6rem, 11vw, 4.2rem); }
    .hero__aside { padding-bottom: 0; }
  }

  /* ---------------- Social proof / stat ---------------- */
  .proof { border-block: 1px solid var(--line-soft); }
  .proof__grid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-m);
    padding-block: var(--space-l);
  }
  .proof__stat { display: flex; align-items: baseline; gap: 0.6em; }
  .proof__num {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(3.2rem, 2rem + 5vw, 6rem);
    letter-spacing: -0.04em;
    line-height: 0.85;
    color: var(--ink);
  }
  .proof__label {
    font-family: var(--font-display);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    color: var(--smoke);
    line-height: 1.3;
  }
  .proof__disciplines {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em 1.6em;
  }
  .proof__disciplines li {
    position: relative;
    font-family: var(--font-display);
    font-size: var(--step-0);
    letter-spacing: -0.01em;
    color: var(--ink);
    padding-left: 1.1em;
  }
  .proof__disciplines li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    background: var(--red);
    border-radius: 50%;
  }
  @media (max-width: 720px) {
    .proof__grid { flex-direction: column; align-items: flex-start; gap: var(--space-s); }
  }

  /* ---------------- Philosophy ---------------- */
  .philosophy__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-m);
  }
  .philosophy__statement {
    font-size: var(--step-3);
    line-height: 1.02;
    letter-spacing: -0.03em;
    max-width: 20ch;
  }
  .philosophy__statement .serif-accent { display: block; margin-top: 0.15em; }
  .philosophy__body {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-m);
    max-width: 62ch;
    margin-left: auto;
    font-size: var(--step-0);
    line-height: 1.55;
  }
  @media (max-width: 720px) {
    .philosophy__body { grid-template-columns: 1fr; }
  }

  /* ---------------- Selected work (editorial) ---------------- */
  .work-editorial {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-m) var(--space-s);
  }
  .work-editorial :global(.film-card--wide) { grid-column: 1 / -1; }
  .work-note {
    margin-top: var(--space-m);
    font-size: var(--step--1);
    color: var(--smoke-dim);
  }
  @media (max-width: 720px) {
    .work-editorial { grid-template-columns: 1fr; }
  }

  /* ---------------- Why TG Visuals ---------------- */
  .why__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: var(--space-l);
    align-items: start;
  }
  .why__title {
    font-size: var(--step-3);
    letter-spacing: -0.03em;
    line-height: 1.02;
    margin: 0.4em 0 0.6em;
  }
  .why__lede { max-width: 34ch; font-size: var(--step-0); }
  .why__list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-m);
  }
  .why__item {
    border-top: 1px solid var(--line-soft);
    padding-top: 1.1em;
  }
  .why__no {
    font-family: var(--font-display);
    font-size: 0.8rem;
    color: var(--red);
    letter-spacing: 0.08em;
  }
  .why__item-title {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0.5em 0 0.4em;
  }
  .why__item-body { font-size: var(--step--1); max-width: 30ch; }
  @media (max-width: 900px) {
    .why__grid { grid-template-columns: 1fr; gap: var(--space-m); }
  }
  @media (max-width: 480px) {
    .why__list { grid-template-columns: 1fr; }
  }

  /* ---------------- Services (typographic rows) ---------------- */
  .services-list { border-top: 1px solid var(--line-soft); }
  .service-row {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--space-m);
    align-items: baseline;
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--line-soft);
    transition: padding-left var(--dur) var(--ease);
  }
  .service-row:hover { padding-left: 0.6rem; }
  .service-row__no {
    font-family: var(--font-display);
    font-size: 0.8rem;
    color: var(--red);
    letter-spacing: 0.08em;
  }
  .service-row__title {
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }
  .service-row__desc { font-size: var(--step-0); max-width: 44ch; }
  @media (max-width: 820px) {
    .service-row {
      grid-template-columns: 2.2rem 1fr;
      gap: 0.4em var(--space-s);
    }
    .service-row__desc { grid-column: 2; }
  }

  /* ---------------- Social / performance ---------------- */
  .performance {
    background: var(--paper-2);
    border-block: 1px solid var(--line-soft);
  }
  .performance__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--space-l);
    align-items: center;
  }
  .performance__title {
    font-size: var(--step-3);
    letter-spacing: -0.03em;
    line-height: 1.02;
    margin: 0.4em 0 0.6em;
  }
  .performance__body { max-width: 42ch; font-size: var(--step-0); line-height: 1.55; }
  .performance__stat {
    display: flex;
    align-items: baseline;
    gap: 0.6em;
    margin-top: var(--space-m);
    padding-top: var(--space-s);
    border-top: 1px solid var(--line-soft);
  }
  .performance__num {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.6rem, 1.6rem + 3.5vw, 4rem);
    letter-spacing: -0.04em;
    line-height: 0.85;
    color: var(--ink);
  }
  .performance__stat-label {
    font-size: var(--step--1);
    color: var(--smoke);
    max-width: 18ch;
    line-height: 1.3;
  }
  .performance__link { display: inline-block; margin-top: var(--space-m); color: var(--ink); }
  .performance__reel {
    display: flex;
    gap: var(--space-s);
    overflow-x: auto;
    padding-bottom: 0.5em;
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(90deg, #000 88%, transparent);
    mask-image: linear-gradient(90deg, #000 88%, transparent);
  }
  .performance__reel::-webkit-scrollbar { display: none; }
  .clip {
    flex: 0 0 auto;
    width: clamp(140px, 40vw, 200px);
  }
  .clip__img {
    width: 100%;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    border-radius: var(--radius-media);
    background: var(--charcoal);
  }
  .clip__cap {
    margin-top: 0.7em;
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--smoke-dim);
  }
  @media (max-width: 900px) {
    .performance__grid { grid-template-columns: 1fr; gap: var(--space-m); }
  }

  /* ---------------- About teaser — the RED chapter ---------------- */
  .about-teaser {
    background: var(--red);
    color: var(--white);
    padding-block: var(--space-2xl);
  }
  .about-teaser__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: var(--space-l);
    align-items: center;
  }
  .about-teaser__img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 28%;
    border-radius: var(--radius-media);
  }
  .about-teaser__eyebrow { color: rgba(255, 255, 255, 0.85); }
  .about-teaser__eyebrow::before { background: var(--ink); }
  .about-teaser__lead {
    font-size: var(--step-4);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.95;
    margin: 0.3em 0 0.5em;
  }
  .about-teaser__lead .serif-accent { color: var(--ink); }
  .about-teaser__intro {
    font-size: var(--step-1);
    line-height: 1.4;
    max-width: 40ch;
    color: rgba(255, 255, 255, 0.92);
  }
  .about-teaser__link { display: inline-block; margin-top: 1.8em; color: var(--white); }
  @media (max-width: 820px) {
    .about-teaser__grid { grid-template-columns: 1fr; }
    .about-teaser__img { aspect-ratio: 3 / 4; max-height: 72vh; }
  }

  /* ---------------- Process ---------------- */
  .process__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-m) var(--space-s);
  }
  .process__step { border-top: 1px solid var(--line); padding-top: 1.1em; }
  .process__no {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    color: var(--red);
    letter-spacing: -0.02em;
  }
  .process__title {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0.5em 0 0.4em;
  }
  .process__body { font-size: var(--step--1); }
  @media (max-width: 820px) {
    .process__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .process__grid { grid-template-columns: 1fr; }
  }

  /* ---------------- Testimonials ---------------- */
  .testimonials__list {
    display: grid;
    gap: var(--space-l);
    margin-top: var(--space-l);
  }
  .testimonial { max-width: 24ch; }
  .testimonial__quote {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
    max-width: 20ch;
  }
  .testimonial__by { display: flex; flex-direction: column; margin-top: 1.4em; }
  .testimonial__name { font-family: var(--font-display); font-weight: 600; }
  .testimonial__role { font-size: var(--step--1); color: var(--smoke-dim); }
</style>
