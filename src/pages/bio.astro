---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/portrait/thor-portrait.jpg';
---

<BaseLayout
  title="Bio"
  description="Thorin Goldswain, the filmmaker and photographer behind TG Visuals."
>
  <section class="bio">
    <div class="container bio__grid">
      <div class="bio__media" data-reveal>
        <Image
          src={portrait}
          alt="Thorin Goldswain, filmmaker and photographer behind TG Visuals"
          widths={[420, 640, 900]}
          sizes="(max-width: 820px) 100vw, 38vw"
          class="bio__img"
          loading="eager"
        />
      </div>
      <div class="bio__body" data-reveal style="--reveal-delay:.08s">
        <h1 class="bio__lead">Bio</h1>
        <p class="bio__text">
          Thorin Goldswain is a filmmaker and photographer with a passion for creating
          visuals that feel premium, natural and impactful. He enjoys working with people,
          capturing genuine moments and turning ideas into something you can see and feel.
          Whether it’s a carefully crafted film, a brand story or social content, he
          approaches every project with a focus on creativity, detail and storytelling.
        </p>
        <p class="bio__text">
          Born and raised in Cape Town, South Africa, Thorin’s journey into filmmaking began
          with a fascination for visual storytelling and the ability to communicate through
          images. Over time, that passion has grown into a broader interest in the creative
          process, from developing ideas and understanding audiences to creating content that
          not only looks good, but resonates with people.
        </p>
        <a href="/work" class="link-underline bio__link">View the work <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .bio {
    padding-top: calc(var(--nav-h) + var(--space-xl));
    padding-bottom: var(--space-2xl);
  }
  .bio__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--space-l);
    align-items: center;
  }
  .bio__img {
    width: 100%;
    max-width: 80%;
    margin-inline: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 22%;
  }
  .bio__lead {
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0 0 1em;
  }
  .bio__text {
    color: var(--smoke);
    max-width: 50ch;
    font-size: var(--step--1);
    line-height: 1.75;
  }
  .bio__text + .bio__text { margin-top: 1.2em; }
  .bio__link { display: inline-block; margin-top: 1.8em; color: var(--ink); }
  @media (max-width: 820px) {
    .bio__grid { grid-template-columns: 1fr; gap: var(--space-m); }
    .bio__img { max-width: 62%; aspect-ratio: 4 / 5; }
  }
  @media (max-width: 560px) {
    .bio__img { max-width: 78%; }
  }
</style>
