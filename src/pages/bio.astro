---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/portrait/thor-portrait.jpg';
---

<BaseLayout
  title="Bio"
  description="Thorin Goldswain — the filmmaker and photographer behind TG Visuals."
>
  <section class="bio">
    <div class="container bio__grid">
      <div class="bio__media" data-reveal>
        <Image
          src={portrait}
          alt="Thorin Goldswain, filmmaker and photographer behind TG Visuals"
          widths={[420, 640, 900]}
          sizes="(max-width: 820px) 100vw, 38vw"
          class="bio__img"
          loading="eager"
        />
      </div>
      <div class="bio__body" data-reveal style="--reveal-delay:.08s">
        <p class="eyebrow">Bio</p>
        <h1 class="bio__lead">Thorin Goldswain</h1>
        <p class="bio__sub">The person behind the camera</p>
        <p class="bio__text">
          I’m a filmmaker and photographer with a passion for creating visuals that feel
          cinematic, natural and impactful. I love working with people, capturing genuine
          moments and turning ideas into something you can see and feel. I’ve always had a
          deep passion for my craft, and I’m constantly looking for new ways to tell stories
          and create work that I’m proud to put my name behind.
        </p>
        <a href="/work" class="link-underline bio__link">View the work <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .bio {
    padding-top: calc(var(--nav-h) + var(--space-xl));
    padding-bottom: var(--space-2xl);
  }
  .bio__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--space-l);
    align-items: center;
  }
  .bio__img {
    width: 100%;
    max-width: 80%;
    margin-inline: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 22%;
  }
  .bio__lead {
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin-top: 0.4em;
  }
  .bio__sub {
    font-family: var(--font-display);
    font-size: var(--step-0);
    letter-spacing: 0.02em;
    color: var(--smoke-dim);
    margin: 0.5em 0 1.4em;
  }
  .bio__text {
    color: var(--smoke);
    max-width: 52ch;
    line-height: 1.7;
  }
  .bio__link { display: inline-block; margin-top: 1.8em; color: var(--ink); }
  @media (max-width: 820px) {
    .bio__grid { grid-template-columns: 1fr; gap: var(--space-m); }
    .bio__img { max-width: 62%; aspect-ratio: 4 / 5; max-height: none; }
  }
  @media (max-width: 560px) {
    .bio__img { max-width: 78%; }
  }
</style>
