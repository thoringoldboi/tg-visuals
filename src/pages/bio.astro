---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/portrait/thor-portrait.jpg';
import Results from '../components/Results.astro';

const experience = [
  {
    name: 'SHOOT. Studios',
    role: 'Manager',
    when: 'Apr 2025 – May 2026',
    where: 'Photography & video studio, Woodstock, Cape Town',
    desc: 'Ran all of the studio’s content: concepts, filming and editing for its short-form promo videos and social channels, plus its Meta ad campaigns. Also managed bookings and clients and came up with the monthly specials. Instagram grew from under 500 to around 5,000 followers, and TikTok from 0 to around 2,000, organically.',
    links: [
      { label: 'Instagram', url: 'https://www.instagram.com/shootstudiosct/' },
      { label: 'TikTok', url: 'https://www.tiktok.com/@shootstudios' },
    ],
  },
  {
    name: 'Nova Move',
    role: 'Content',
    when: 'Ongoing',
    where: 'South African home gym brand',
    desc: 'Product-focused content for organic social and paid ads.',
    links: [],
  },
  {
    name: 'Studios World',
    role: 'Content',
    when: 'Ongoing',
    where: '@studios_world_',
    desc: 'Developing ideas and producing social content for the brand.',
    links: [{ label: 'Instagram', url: 'https://www.instagram.com/studios_world_/' }],
  },
  {
    name: 'TG Visuals',
    role: 'Founder',
    when: 'Ongoing',
    where: 'Cape Town',
    desc: 'My own filmmaking and photography: film, commercial and social video, plus studio, portrait and automotive photography.',
    links: [],
  },
];

const skills = [
  {
    group: 'Creative production',
    items: ['Filmmaking & cinematography', 'Video production', 'Creative development & storytelling', 'Colour grading', 'Sound design & music selection'],
  },
  {
    group: 'Content & performance',
    items: ['Short-form video editing', 'Hooks, pacing & retention', 'Social media content creation', 'Organic social growth', 'Meta Ads Manager & campaigns'],
  },
  {
    group: 'Software',
    items: ['DaVinci Resolve', 'CapCut', 'Adobe Lightroom', 'Meta Ads Manager', 'Notion'],
  },
];
---

<BaseLayout
  title="Bio"
  description="Thorin Goldswain: creative producer and filmmaker in Cape Town. Film, short-form social content, organic growth and Meta ads."
>
  <section class="bio">
    <div class="container bio__grid">
      <div class="bio__media" data-reveal>
        <Image
          src={portrait}
          alt="Thorin Goldswain, filmmaker and photographer behind TG Visuals"
          widths={[420, 640, 900]}
          sizes="(max-width: 820px) 100vw, 38vw"
          class="bio__img"
          loading="eager"
        />
      </div>
      <div class="bio__body" data-reveal style="--reveal-delay:.08s">
        <p class="eyebrow">Bio</p>
        <h1 class="bio__lead">Thorin Goldswain</h1>
        <p class="bio__sub">Creative producer & filmmaker · Cape Town</p>
        <p class="bio__text">
          I shoot, edit and colour grade, and a lot of what I make is built for social, so I
          think about the first two seconds as carefully as the final grade. I love working with
          people, capturing genuine moments and turning ideas into something you can see and feel.
        </p>
        <p class="bio__text">
          Alongside the creative work I’ve been hands-on with organic social and Meta ad
          campaigns, most recently as manager at SHOOT. Studios. That taught me how creative
          production, social performance and business goals connect, and it shapes how I
          approach every brief.
        </p>
        <a href="/work" class="link-underline bio__link">View the work <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="cv">
    <div class="container">
      <Results />

      <div class="cv__block">
        <h2 class="cv__head" data-reveal>Experience</h2>
        <ol class="exp">
          {experience.map((e, i) => (
            <li class="exp__item" data-reveal style={`--reveal-delay:${0.05 + i * 0.05}s`}>
              <div class="exp__meta">
                <span class="exp__when">{e.when}</span>
              </div>
              <div class="exp__body">
                <h3 class="exp__name">{e.name} <span class="exp__role">{e.role}</span></h3>
                <p class="exp__where">{e.where}</p>
                <p class="exp__desc">{e.desc}</p>
                {e.links.length > 0 && (
                  <p class="exp__links">
                    {e.links.map((l) => (
                      <a href={l.url} class="link-underline" target="_blank" rel="noopener">{l.label} ↗</a>
                    ))}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="cv__block">
        <h2 class="cv__head" data-reveal>Skills & tools</h2>
        <div class="skills">
          {skills.map((g, i) => (
            <div class="skills__col" data-reveal style={`--reveal-delay:${0.05 + i * 0.06}s`}>
              <h3 class="skills__group">{g.group}</h3>
              <ul class="skills__list">{g.items.map((x) => <li>{x}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>

      <div class="cv__cta" data-reveal>
        <a href="/services" class="btn">What I offer <span class="btn__arrow" aria-hidden="true">↗</span></a>
        <a href="/contact" class="link-underline">Start a project ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .bio {
    padding-top: calc(var(--nav-h) + var(--space-xl));
    padding-bottom: var(--space-xl);
  }
  .bio__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--space-l);
    align-items: center;
  }
  .bio__img {
    width: 100%;
    max-width: 80%;
    margin-inline: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 22%;
  }
  .bio__lead {
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin-top: 0.4em;
  }
  .bio__sub {
    font-family: var(--font-display);
    font-size: var(--step-0);
    letter-spacing: 0.02em;
    color: var(--smoke-dim);
    margin: 0.5em 0 1.4em;
  }
  .bio__text {
    color: var(--smoke);
    max-width: 52ch;
    line-height: 1.7;
  }
  .bio__text + .bio__text { margin-top: 1em; }

  /* ---------------- CV: results, experience, skills ---------------- */
  .cv { padding-bottom: var(--space-2xl); }
  .cv__block { margin-top: var(--space-2xl); }
  .cv__head {
    font-size: var(--step-2);
    letter-spacing: -0.025em;
    padding-bottom: var(--space-s);
    border-bottom: 1px solid var(--line);
  }
  .exp { list-style: none; margin: 0; padding: 0; }
  .exp__item {
    display: grid;
    grid-template-columns: 1fr 2.4fr;
    gap: var(--space-m);
    padding: var(--space-m) 0;
    border-bottom: 1px solid var(--line);
  }
  .exp__when {
    font-family: var(--font-display);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--smoke-dim);
  }
  .exp__name {
    font-size: var(--step-1);
    letter-spacing: -0.015em;
    line-height: 1.15;
  }
  .exp__role {
    font-weight: 400;
    color: var(--smoke-dim);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    margin-left: 0.5em;
  }
  .exp__where { font-size: var(--step--1); color: var(--smoke-dim); margin-top: 0.3em; }
  .exp__desc { color: var(--smoke); line-height: 1.65; max-width: 62ch; margin-top: 0.8em; }
  .exp__links { display: flex; gap: var(--space-s); margin-top: 0.9em; font-size: var(--step--1); }
  .exp__links a { color: var(--ink); }
  .skills {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-m);
    margin-top: var(--space-m);
  }
  .skills__group {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--smoke-dim);
    margin-bottom: 0.9em;
  }
  .skills__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5em; }
  .skills__list li { line-height: 1.4; }
  .cv__cta {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    flex-wrap: wrap;
    margin-top: var(--space-2xl);
  }
  .cv__cta .link-underline { color: var(--ink); }
  @media (max-width: 760px) {
    .exp__item { grid-template-columns: 1fr; gap: 0.4em; }
    .skills { grid-template-columns: 1fr; }
  }
  .bio__link { display: inline-block; margin-top: 1.8em; color: var(--ink); }
  @media (max-width: 820px) {
    .bio__grid { grid-template-columns: 1fr; gap: var(--space-m); }
    .bio__img { max-width: 62%; aspect-ratio: 4 / 5; max-height: none; }
  }
  @media (max-width: 560px) {
    .bio__img { max-width: 78%; }
  }
</style>
