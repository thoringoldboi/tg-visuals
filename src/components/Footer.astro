---
import Logo from './Logo.astro';
import { contact, site, socialLinks } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="container site-footer__inner">
    <p class="eyebrow site-footer__eyebrow">Get in touch</p>
    <a href={`mailto:${contact.email}`} class="site-footer__email">{contact.email}</a>

    <div class="site-footer__links">
      {
        socialLinks.map((l) => (
          <a
            href={l.url}
            class="link-underline"
            {...(l.url.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {l.label}
          </a>
        ))
      }
    </div>

    <div class="site-footer__base">
      <Logo variant="light" wordmark={false} class="site-footer__logo" />
      <span>© {year} {site.name}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink-900);
    color: var(--on-dark);
    padding-block: var(--space-2xl) var(--space-l);
  }
  .site-footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .site-footer__eyebrow { color: var(--on-dark-dim); }
  .site-footer__email {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.8rem, 1rem + 4vw, 4rem);
    letter-spacing: -0.03em;
    color: var(--white);
    margin: 0.5em 0 0.9em;
    transition: opacity var(--dur) var(--ease);
  }
  .site-footer__email:hover { opacity: 0.7; }
  .site-footer__links {
    display: flex;
    gap: var(--space-m);
    color: var(--on-dark-dim);
  }
  .site-footer__links a:hover { color: var(--white); }
  .site-footer__base {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    margin-top: var(--space-2xl);
    font-size: var(--step--1);
    color: var(--on-dark-dim);
  }
  .site-footer__logo :global(.logo__mark) { height: 1.5em; opacity: 0.9; }
</style>
