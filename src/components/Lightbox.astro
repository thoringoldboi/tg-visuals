---
// Renders the lightbox overlay once per page. Any <img> inside an element with
// [data-lightbox-group] becomes clickable; navigation is scoped to its group.
---

<div class="lightbox" data-lightbox hidden aria-hidden="true">
  <button class="lightbox__close" data-lb-close aria-label="Close">✕</button>
  <button class="lightbox__nav lightbox__nav--prev" data-lb-prev aria-label="Previous image">‹</button>
  <figure class="lightbox__stage">
    <img class="lightbox__img" data-lb-img alt="" />
    <figcaption class="lightbox__caption" data-lb-caption></figcaption>
  </figure>
  <button class="lightbox__nav lightbox__nav--next" data-lb-next aria-label="Next image">›</button>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(0.5rem, 3vw, 2rem);
    padding: clamp(1rem, 4vw, 3rem);
    background: color-mix(in srgb, var(--ink-900) 94%, transparent);
    backdrop-filter: blur(10px);
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }
  .lightbox[data-open] { opacity: 1; }
  .lightbox__stage {
    display: grid;
    justify-items: center;
    gap: 1em;
    max-height: 100%;
  }
  .lightbox__img {
    max-width: 100%;
    max-height: 82vh;
    object-fit: contain;
    border-radius: var(--radius-media);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
  }
  .lightbox__caption {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--smoke-dim);
  }
  .lightbox__close,
  .lightbox__nav {
    background: transparent;
    border: 1px solid var(--line);
    color: var(--white);
    border-radius: 50%;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }
  .lightbox__nav {
    width: clamp(44px, 5vw, 60px);
    aspect-ratio: 1;
    font-size: 1.6rem;
  }
  .lightbox__nav:hover { background: var(--red); border-color: var(--red); }
  .lightbox__close {
    position: absolute;
    top: clamp(1rem, 3vw, 2rem);
    right: clamp(1rem, 3vw, 2rem);
    width: 46px;
    aspect-ratio: 1;
    font-size: 1rem;
  }
  .lightbox__close:hover { background: var(--red); border-color: var(--red); rotate: 90deg; }

  [data-lightbox-group] img { cursor: zoom-in; }

  @media (max-width: 640px) {
    .lightbox { grid-template-columns: 1fr; }
    .lightbox__nav { position: absolute; bottom: 1.2rem; }
    .lightbox__nav--prev { left: 1.2rem; }
    .lightbox__nav--next { right: 1.2rem; }
  }
</style>

<script>
  const lb = document.querySelector<HTMLElement>('[data-lightbox]');
  if (lb) {
    const imgEl = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const capEl = lb.querySelector<HTMLElement>('[data-lb-caption]')!;
    let group: HTMLImageElement[] = [];
    let index = 0;
    let lastFocused: HTMLElement | null = null;

    function show(i: number) {
      index = (i + group.length) % group.length;
      const src = group[index].currentSrc || group[index].src;
      imgEl.src = src;
      const cap = group[index].getAttribute('data-caption') || group[index].alt || '';
      imgEl.alt = group[index].alt || '';
      capEl.textContent = cap;
    }
    function open(items: HTMLImageElement[], i: number, trigger: HTMLElement) {
      group = items;
      lastFocused = trigger;
      lb!.hidden = false;
      lb!.setAttribute('aria-hidden', 'false');
      requestAnimationFrame(() => lb!.setAttribute('data-open', ''));
      document.body.style.overflow = 'hidden';
      show(i);
    }
    function close() {
      lb!.removeAttribute('data-open');
      lb!.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      setTimeout(() => (lb!.hidden = true), 350);
      lastFocused?.focus();
    }

    document.querySelectorAll<HTMLElement>('[data-lightbox-group]').forEach((grp) => {
      const imgs = Array.from(grp.querySelectorAll<HTMLImageElement>('img'));
      imgs.forEach((img, i) => {
        img.addEventListener('click', () => open(imgs, i, img));
        img.setAttribute('tabindex', '0');
        img.setAttribute('role', 'button');
        img.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            open(imgs, i, img);
          }
        });
      });
    });

    lb.querySelector('[data-lb-close]')?.addEventListener('click', close);
    lb.querySelector('[data-lb-next]')?.addEventListener('click', () => show(index + 1));
    lb.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(index - 1));
    lb.addEventListener('click', (e) => {
      if (e.target === lb) close();
    });
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });
  }
</script>
