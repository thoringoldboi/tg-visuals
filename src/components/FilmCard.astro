---
import { Image } from 'astro:assets';
import { img, type Film } from '../data/work';

interface Props {
  film: Film;
  index?: number;
  /** 'wide' spans full width with large type; 'tile' is a grid item. */
  variant?: 'wide' | 'tile';
  sizes?: string;
}
const { film, index, variant = 'tile', sizes = '(max-width: 900px) 100vw, 50vw' } = Astro.props;
const cover = img(film.cover);
---

<a href={`/work/${film.slug}`} class:list={['film-card', `film-card--${variant}`]} data-reveal>
  <div class="film-card__media">
    <Image
      src={cover}
      alt={`${film.title} — ${film.category}`}
      class="film-card__img"
      widths={[480, 800, 1200, 1600]}
      sizes={sizes}
      loading="lazy"
    />
    <span class="film-card__badge">{film.category}</span>
    <span class="film-card__view">
      View project <span aria-hidden="true">↗</span>
    </span>
  </div>
  <div class="film-card__meta">
    <div class="film-card__titlerow">
      {index != null && <span class="film-card__index">{String(index).padStart(2, '0')}</span>}
      <h3 class="film-card__title">{film.title}</h3>
    </div>
    <p class="film-card__client">{film.category} · {film.year}</p>
  </div>
</a>

<style>
  .film-card {
    display: block;
    group: card;
  }
  .film-card__media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: var(--charcoal);
  }
  .film-card--wide .film-card__media {
    aspect-ratio: 16 / 8;
  }
  .film-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease), filter 0.7s var(--ease);
  }
  .film-card:hover .film-card__img {
    transform: scale(1.05);
    filter: brightness(0.7) saturate(1.05);
  }
  .film-card__badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--white);
    background: color-mix(in srgb, var(--ink) 55%, transparent);
    backdrop-filter: blur(6px);
    border: 1px solid var(--line);
    padding: 0.5em 0.9em;
    border-radius: 999px;
  }
  .film-card__view {
    position: absolute;
    left: 1.2rem;
    bottom: 1.2rem;
    font-family: var(--font-display);
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    color: var(--white);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .film-card:hover .film-card__view,
  .film-card:focus-visible .film-card__view {
    opacity: 1;
    transform: none;
  }
  .film-card__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    margin-top: 1.1em;
    padding-bottom: 0.9em;
    border-bottom: 1px solid var(--line-soft);
    transition: border-color var(--dur) var(--ease);
  }
  .film-card:hover .film-card__meta {
    border-color: var(--red);
  }
  .film-card__titlerow {
    display: flex;
    align-items: baseline;
    gap: 0.7em;
  }
  .film-card__index {
    font-family: var(--font-display);
    font-size: 0.8rem;
    color: var(--red);
    letter-spacing: 0.08em;
  }
  .film-card__title {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .film-card--wide .film-card__title {
    font-size: var(--step-2);
  }
  .film-card__client {
    font-size: var(--step--1);
    color: var(--smoke-dim);
    white-space: nowrap;
  }
</style>
