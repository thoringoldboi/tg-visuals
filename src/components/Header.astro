---
import Logo from './Logo.astro';
import { nav, contact, ctaLabel } from '../config/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// Highlight only the most specific matching nav item (longest matching href),
// so e.g. /work/social lights up "Social", not both "Work" and "Social".
const activeHref = nav
  .map((n) => n.href)
  .filter((href) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/')))
  .sort((a, b) => b.length - a.length)[0];
const isActive = (href: string) => href === activeHref;
---

<header class="site-header" data-header>
  <div class="site-header__inner container">
    <Logo wordmark={false} />

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav__link', { 'is-active': isActive(item.href) }]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/contact" class="btn btn--red site-header__cta">
      {ctaLabel}
      <span class="btn__arrow" aria-hidden="true">↗</span>
    </a>

    <button
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
      data-nav-toggle
    >
      <span></span><span></span>
    </button>
  </div>
</header>

<!-- Full-screen mobile menu -->
<div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
  <nav class="mobile-menu__nav" aria-label="Mobile">
    <ul>
      {
        nav.map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={item.href} class="mobile-menu__link" data-menu-link>
              <span class="mobile-menu__index">0{i + 1}</span>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="mobile-menu__foot">
    <a href={`mailto:${contact.email}`} class="link-underline">{contact.email}</a>
    <a href={contact.instagram.url} class="link-underline" target="_blank" rel="noopener">
      Instagram
    </a>
  </div>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    background: var(--paper);
    transition: transform 0.5s var(--ease), border-color 0.5s var(--ease);
    border-bottom: 1px solid transparent;
  }
  /* Hairline appears once scrolled */
  .site-header[data-scrolled] {
    border-bottom-color: var(--line-soft);
  }
  .site-header[data-hidden] {
    transform: translateY(-100%);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    width: 100%;
  }

  .nav {
    margin-left: auto;
  }
  .nav__list {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 2.2vw, 2.6rem);
    list-style: none;
    padding: 0;
  }
  .nav__link {
    position: relative;
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--smoke);
    padding: 0.4em 0;
    transition: color var(--dur) var(--ease);
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur) var(--ease);
  }
  .nav__link:hover,
  .nav__link.is-active {
    color: var(--ink);
  }
  .nav__link:hover::after,
  .nav__link.is-active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-header__cta {
    padding: 0.7em 1.25em;
  }

  /* Hamburger */
  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    position: relative;
  }
  .nav-toggle span {
    position: absolute;
    left: 9px;
    right: 9px;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.4s var(--ease), opacity 0.3s var(--ease);
  }
  .nav-toggle span:first-child {
    top: 18px;
  }
  .nav-toggle span:last-child {
    bottom: 18px;
  }
  body[data-menu-open] .nav-toggle span:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  body[data-menu-open] .nav-toggle span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  /* Mobile menu overlay */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: var(--paper);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--nav-h) var(--gutter) var(--space-l);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s var(--ease);
  }
  .mobile-menu[data-open] {
    opacity: 1;
    pointer-events: auto;
  }
  .mobile-menu__nav ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.1em;
  }
  .mobile-menu__link {
    display: flex;
    align-items: baseline;
    gap: 0.8em;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.4rem, 12vw, 4rem);
    letter-spacing: -0.02em;
    color: var(--ink);
    padding: 0.12em 0;
    opacity: 0;
    transform: translateY(20px);
  }
  .mobile-menu[data-open] .mobile-menu__link {
    animation: menuIn 0.6s var(--ease-out) forwards;
    animation-delay: calc(0.08s * var(--i) + 0.1s);
  }
  @keyframes menuIn {
    to {
      opacity: 1;
      transform: none;
    }
  }
  .mobile-menu__index {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--red);
    letter-spacing: 0.1em;
  }
  .mobile-menu__foot {
    margin-top: var(--space-l);
    display: flex;
    gap: var(--space-m);
    color: var(--smoke);
  }

  @media (max-width: 860px) {
    .nav,
    .site-header__cta {
      display: none;
    }
    .nav-toggle {
      display: block;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu__link {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>

<script>
  // Sticky-nav behaviour: condense on scroll, hide on scroll-down, reveal on scroll-up.
  const header = document.querySelector<HTMLElement>('[data-header]');
  let lastY = window.scrollY;
  let ticking = false;

  function onScroll() {
    const y = window.scrollY;
    if (!header) return;
    header.toggleAttribute('data-scrolled', y > 24);
    const menuOpen = document.body.hasAttribute('data-menu-open');
    if (!menuOpen) {
      if (y > lastY && y > 300) header.setAttribute('data-hidden', '');
      else header.removeAttribute('data-hidden');
    }
    lastY = y;
    ticking = false;
  }
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        requestAnimationFrame(onScroll);
        ticking = true;
      }
    },
    { passive: true }
  );
  onScroll();

  // Mobile menu
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  function setMenu(open: boolean) {
    if (!menu || !toggle) return;
    document.body.toggleAttribute('data-menu-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    if (open) {
      menu.hidden = false;
      requestAnimationFrame(() => menu.setAttribute('data-open', ''));
      document.body.style.overflow = 'hidden';
    } else {
      menu.removeAttribute('data-open');
      document.body.style.overflow = '';
      setTimeout(() => (menu.hidden = true), 500);
    }
  }

  toggle?.addEventListener('click', () =>
    setMenu(!document.body.hasAttribute('data-menu-open'))
  );
  menu?.querySelectorAll('[data-menu-link]').forEach((l) =>
    l.addEventListener('click', () => setMenu(false))
  );
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && document.body.hasAttribute('data-menu-open')) setMenu(false);
  });
</script>
