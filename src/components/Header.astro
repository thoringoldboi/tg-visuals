---
import { nav } from '../config/site';

interface Props {
  /** Transparent over a full-screen hero, turning solid on scroll (home only). */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
---

<header
  class:list={['site-header', { 'is-solid': !overlay }]}
  data-header
  data-overlay={overlay ? '' : undefined}
>
  <div class="site-header__inner container">
    <a href="/" class="wordmark" aria-label="TG Visuals — home">TG VISUALS</a>
    <nav class="nav" aria-label="Primary">
      {nav.map((item) => <a href={item.href} class="nav__link">{item.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    color: #fff;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background 0.4s var(--ease), color 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }
  /* Solid on non-hero pages, and once scrolled past the hero */
  .site-header.is-solid,
  .site-header[data-scrolled] {
    background: var(--paper);
    color: var(--ink);
    border-bottom-color: var(--line-soft);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    width: 100%;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.14em;
    color: currentColor;
  }
  .nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2.4rem);
  }
  .nav__link {
    position: relative;
    font-family: var(--font-display);
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    color: currentColor;
    opacity: 0.85;
    padding: 0.3em 0;
    transition: opacity var(--dur) var(--ease);
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur) var(--ease);
  }
  .nav__link:hover { opacity: 1; }
  .nav__link:hover::after { transform: scaleX(1); transform-origin: left; }

  /* Compact nav on phones so everything fits comfortably */
  @media (max-width: 560px) {
    .wordmark { font-size: 0.82rem; letter-spacing: 0.08em; }
    .nav { gap: 1.1rem; }
    .nav__link { font-size: 0.82rem; }
  }
</style>

<script>
  // Only the overlay (home) header switches transparent → solid on scroll.
  const header = document.querySelector<HTMLElement>('[data-header][data-overlay]');
  if (header) {
    let ticking = false;
    const onScroll = () => {
      const threshold = window.innerHeight * 0.85;
      header.toggleAttribute('data-scrolled', window.scrollY > threshold);
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(onScroll);
          ticking = true;
        }
      },
      { passive: true }
    );
    onScroll();
  }
</script>
